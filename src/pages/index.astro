---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
import ScrollPhrase from "../components/ScrollPhrase.astro";
import Projects from "../components/Projects.astro";
import Stack from "../components/Stack.astro";
import Experience from "../components/Experience.astro";
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";

const title = "Saulo Quiñones: Environmental Engineer & GIS Specialist";
const description =
  "Web, spatial data, and applied AI. I build interactive web tools, geospatial pipelines, and applied AI systems that turn real information into things people actually use, from raw data to production.";
---

<Base title={title} description={description}>
  <Nav />
  <main>
    <Hero />
    <About />
    <Services />
    <ScrollPhrase />
    <Experience />
    <Projects />
    <Stack />
    <ContactForm />
  </main>
  <Footer />
</Base>
