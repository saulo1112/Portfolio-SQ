---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";

const github = "https://github.com/saulo1112"; // TODO: repo URL

const tags = ["GIS", "Machine learning", "FastAPI"];
const stack = [
  { name: "Python", note: "feature engineering and model training" },
  { name: "PostGIS", note: "parcel geometry storage and spatial joins" },
  { name: "Google Earth Engine", note: "Sentinel-2 and forest-cover layers" },
  { name: "scikit-learn", note: "risk classifier with honest cross-validation" },
  { name: "Docker", note: "reproducible pipeline and API runtime" },
];

const title = "EUDR Forest Risk Assessment — Saulo Quiñones";
const description =
  "Screening 4,170 real agricultural parcels for EU deforestation compliance using only open satellite data, PostGIS, Earth Engine and scikit-learn.";
---

<Base title={title} description={description}>
  <Nav />
  <main class="case">
    <div class="inner">
      <a class="back" href="/#work">← Back to work</a>

      <ul class="tags">
        {tags.map((t, i) => <li class={i === 0 ? "tag tag-accent" : "tag"}>{t}</li>)}
      </ul>

      <h1>EUDR Forest Risk Assessment</h1>
      <p class="lede">
        How do you screen 4,170 real agricultural parcels for EU deforestation
        compliance — using only open satellite data?
      </p>

      <section class="block">
        <h2>Context</h2>
        <p>
          The EU Deforestation Regulation (EUDR) requires operators to demonstrate
          that commodities are not linked to land deforested after December 2020.
          For a portfolio of 4,170 agricultural parcels, that means producing a
          defensible, per-parcel risk signal — without buying proprietary data.
        </p>
      </section>

      <section class="block">
        <h2>Approach</h2>
        <ul class="steps">
          <li>
            Ingested and validated parcel geometries in PostGIS, fixing invalid
            topology and indexing for fast spatial joins.
          </li>
          <li>
            Pulled Sentinel-2 imagery and open forest-cover layers per parcel
            through Google Earth Engine.
          </li>
          <li>
            Engineered features — forest loss within and around each parcel,
            proximity to recent loss, and land-cover change over time.
          </li>
          <li>
            Trained a scikit-learn classifier with honest cross-validation to
            output a calibrated per-parcel deforestation risk score.
          </li>
          <li>
            Served scores through a FastAPI endpoint, containerized with Docker
            for a reproducible end-to-end pipeline.
          </li>
        </ul>
      </section>

      <section class="block">
        <h2>Stack</h2>
        <ul class="stacklist">
          {stack.map((s) => (
            <li>
              <span class="name">{s.name}</span>
              <span class="note">{s.note}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="block">
        <h2>Results</h2>
        <p class="todo">
          TODO: add model performance (e.g. ROC-AUC), share of parcels flagged
          high-risk, and pipeline runtime once finalized.
        </p>
      </section>

      <div class="links">
        <a class="link" href={github} target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .case {
    padding: 96px 24px;
  }

  .inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .back {
    display: inline-block;
    margin-bottom: 28px;
    font-size: 13px;
    color: var(--color-text-secondary);
    transition: color 0.15s ease;
  }
  .back:hover {
    color: var(--color-text-primary);
  }

  h1 {
    margin: 16px 0 12px;
    font-size: clamp(28px, 4vw, 38px);
  }

  .lede {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 58ch;
  }

  .block {
    margin-top: 48px;
  }

  .block h2 {
    margin-bottom: 14px;
  }

  .block p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .steps li {
    position: relative;
    padding-left: 18px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }
  .steps li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--color-text-muted);
  }

  .stacklist li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 0;
    border-top: 1px solid var(--color-border);
  }
  .stacklist .name {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-primary);
  }
  .stacklist .note {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .todo {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    font-size: 11px;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: 999px;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }
  .tag-accent {
    background-color: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }

  .links {
    margin-top: 48px;
  }
  .link {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-accent);
  }
  .link:hover {
    color: var(--color-accent-hover);
  }

  @media (max-width: 768px) {
    .case {
      padding: 64px 24px;
    }
  }
</style>
