---
const email = "saulo@email.com"; // TODO: real address
const github = "https://github.com/saulo1112";
const linkedin = "https://www.linkedin.com/in/your-handle"; // TODO: real URL
---

<section class="contact" id="contact">
  <div class="inner">
    <h2>Let's work together</h2>

    <p class="email">
      <a href={`mailto:${email}`}>{email}</a>
    </p>

    <div class="socials">
      <a
        class="icon-link"
        href={github}
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.2-3.1-.12-.3-.52-1.47.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.05.75.81 1.2 1.84 1.2 3.1 0 4.43-2.69 5.41-5.26 5.69.41.36.78 1.05.78 2.12v3.14c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"></path>
        </svg>
      </a>

      <a
        class="icon-link"
        href={linkedin}
        target="_blank"
        rel="noopener"
        aria-label="LinkedIn"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"></path>
        </svg>
      </a>
    </div>

    <p class="location">Cali, Colombia — available for remote work</p>
  </div>
</section>

<style>
  .contact {
    padding: 96px 24px;
  }

  .inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  h2 {
    margin-bottom: 24px;
  }

  .email a {
    font-size: clamp(20px, 3vw, 26px);
    font-weight: 500;
    color: var(--color-accent);
    transition: color 0.15s ease;
  }

  .email a:hover {
    color: var(--color-accent-hover);
  }

  .socials {
    margin-top: 28px;
    display: flex;
    gap: 14px;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    color: var(--color-text-secondary);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .icon-link:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-muted);
  }

  .location {
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .contact {
      padding: 64px 24px;
    }
  }
</style>
