---
// Data-driven cards. Each icon is an inline SVG string (rendered via set:html);
// stroke/fill come from CSS so the icons follow the theme accent.
const cards = [
  {
    title: "Spatial ML & AI",
    desc: "Geospatial ML pipelines, risk scoring models, and deep learning applied to Earth observation data.",
    tags: ["scikit-learn", "Earth Engine", "PostGIS"],
    icon: `<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/>`,
  },
  {
    title: "Geospatial APIs",
    desc: "REST APIs with spatial queries, PostGIS indexing, and geographic data processing at scale.",
    tags: ["FastAPI", "PostGIS", "Python"],
    icon: `<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>`,
  },
  {
    title: "Interactive maps",
    desc: "Web-based cartographic viewers, dashboards, and spatial data visualization.",
    tags: ["Leaflet", "pydeck", "H3"],
    icon: `<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/><circle cx="12" cy="10" r="2"/>`,
  },
  {
    title: "Data pipelines",
    desc: "ETL automation and geodatabase design for environmental and spatial data at scale.",
    tags: ["Python", "Docker", "GDAL"],
    icon: `<path d="M4 6h16M4 12h16M4 18h10"/><polyline points="18 15 21 18 18 21"/>`,
  },
  {
    title: "Backend development",
    desc: "APIs, server logic, and database architecture for web applications and data services.",
    tags: ["Node.js", "Flask", "FastAPI"],
    icon: `<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>`,
  },
  {
    title: "Environmental analytics",
    desc: "Water quality analysis, ecological modeling, and environmental data interpretation.",
    tags: ["Python", "QGIS", "R"],
    icon: `<path d="M12 2l8.66 5v10L12 22l-8.66-5V7z"/>`,
  },
];
---

<section id="services" class="services-section">
  <div class="inner">
    <!-- ---- Left column: Spline particle AI brain ---- -->
    <div class="spline-wrap">
      <iframe
        src="https://my.spline.design/particleaibrain-IpkY3fQsEGl1lDJ6nhX5xVcY/"
        frameborder="0"
        width="100%"
        height="100%"
        title="Particle AI brain — interactive 3D"
        loading="lazy"></iframe>
      <div class="spline-cover" aria-hidden="true"></div>
    </div>

    <!-- ---- Right column: heading + cards ---- -->
    <div class="content">
      <p class="eyebrow">WHAT I DO</p>
      <h2 class="heading">Services &amp;<br /><span>capabilities</span></h2>

      <div class="cards">
        {
          cards.map((card) => (
            <article class="card">
              <div class="card-icon">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  set:html={card.icon}
                />
              </div>
              <h3 class="card-title">{card.title}</h3>
              <p class="card-desc">{card.desc}</p>
              <div class="card-tags">
                {card.tags.map((tag) => (
                  <span class="card-tag">{tag}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: 72px 0 96px;
    border-top: 1px solid var(--color-border);
  }

  .inner {
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  /* ---- Left column: Spline embed ---- */
  .spline-wrap {
    position: relative;
    height: 560px;
    border-radius: 12px;
    overflow: hidden;
    /* Match the portfolio background so mix-blend-mode: lighten on the iframe
       blends away the Spline scene's dark backdrop, leaving only the particles. */
    background: var(--color-bg);
  }

  .spline-wrap iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    mix-blend-mode: lighten;
  }

  /* Masks the Spline watermark in the bottom-right corner (fallback — with
     mix-blend-mode: lighten the dark watermark already blends away). */
  .spline-cover {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 260px;
    height: 52px;
    background: var(--color-bg);
    z-index: 10;
    pointer-events: none;
  }

  /* ---- Right column ---- */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 12px;
  }

  .heading {
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-text-primary);
    margin-bottom: 28px;
  }

  .heading span {
    color: var(--color-accent);
    filter: brightness(1.3);
  }

  /* ---- Cards grid ---- */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, auto);
    gap: 8px;
    align-items: stretch;
  }

  .card {
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
    overflow: hidden;
    cursor: default;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .card:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px
      color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  /* ---- Icon ---- */
  .card-icon {
    width: 32px;
    height: 32px;
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
  }

  .card:hover .card-icon {
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  .card-icon svg {
    width: 16px;
    height: 16px;
    stroke: var(--color-accent);
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---- Content ---- */
  .card-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .card-desc {
    font-size: 11px;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .card-tags {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    padding: 2px 7px;
    border-radius: 4px;
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }

  /* Keyword illumination on hover. */
  .card:hover .card-tag {
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
    color: color-mix(in srgb, var(--color-accent), white 30%);
  }

  @media (max-width: 768px) {
    .services-section {
      padding: 64px 0;
    }

    .inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .spline-wrap {
      display: none;
    }

    .cards {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
  }
</style>
