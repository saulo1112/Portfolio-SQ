---
// Scroll-driven word reveal. Words are split at build time; accent words are
// tagged here (robust against punctuation) so the runtime script only toggles
// the `.active` state.
const phrase =
  "Data, GIS, and AI, in service of systems that show where things happen, explain why they happen, and anticipate what comes next.";

const accentBases = new Set(["show", "explain", "anticipate"]);

// Split each token into leading punctuation, the word itself, and trailing
// punctuation so only the word is tinted with the accent color.
const words = phrase.split(" ").map((text) => {
  const m = text.match(/^([^A-Za-z0-9]*)(.*?)([^A-Za-z0-9]*)$/) ?? [];
  const core = m[2] ?? text;
  return {
    pre: m[1] ?? "",
    core,
    post: m[3] ?? "",
    accent: accentBases.has(core.toLowerCase()),
  };
});
---

<section id="phrase" class="phrase-section">
  <div class="phrase-inner">
    <!-- Left: brain -->
    <div class="phrase-brain">
      <div class="brain-spline">
        <iframe
          src="https://my.spline.design/particleaibrain-IpkY3fQsEGl1lDJ6nhX5xVcY/"
          frameborder="0"
          title="Particle AI brain: interactive 3D"></iframe>
      </div>
      <div class="phrase-brain-cover" aria-hidden="true"></div>
    </div>

    <!-- Right: scroll phrase -->
    <div class="phrase-container">
      <p class="phrase-text" id="phrase-text">
        {
          words.map((w) => (
            <span class="phrase-word">
              {w.pre}
              {w.accent ? <span class="accent">{w.core}</span> : w.core}
              {w.post}{" "}
            </span>
          ))
        }
      </p>
    </div>
  </div>
</section>

<style>
  .phrase-section {
    border-top: 1px solid var(--color-border);
    padding: 36px 0;
  }

  .phrase-inner {
    max-width: 1500px;
    margin: 0 auto;
    padding-inline: 40px;
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 56px;
    align-items: center;
  }

  /* ---- Left: brain ---- */
  .phrase-brain {
    position: relative;
    width: 100%;
    min-width: 600px;
    height: 500px;
    min-height: 500px;
    overflow: hidden;
    background: #0f0f0f;
    border-radius: 12px;
  }

  /* Fills .phrase-brain via absolute positioning — iframe is fully isolated
     from the grid's track-sizing algorithm */
  .brain-spline {
    position: absolute;
    inset: 0;
  }

  .brain-spline iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: none;
  }

  .phrase-brain-cover {
    position: absolute;
    bottom: 12;
    left: 440;
    width: 140px;
    height: 44px;
    background: #0F0F0F;
    z-index: 10;
    pointer-events: none;
    border-radius: 0 0 12px 0;
  }

  /* ---- Right: phrase ---- */
  .phrase-container {
    min-width: 0;
    width: 100%;
    padding-block: 12px;
    padding-right: 48px;
  }

  .phrase-text {
    margin: 0;
    max-width: 100%;
    font-size: clamp(20px, 2vw, 28px);
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: -0.01em;
  }

  .phrase-word {
    --p-dim: rgba(255, 255, 255, 0.15);
    display: inline;
    color: var(--p-dim);
    transition: color 0.4s ease;
  }

  :global(html:not(.dark)) .phrase-word {
    --p-dim: rgba(15, 15, 15, 0.18);
  }

  .phrase-word.active {
    color: var(--color-text-primary);
  }

  .phrase-word.active .accent {
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    .phrase-section {
      padding: 64px 0;
    }

    .phrase-inner {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-inline: 24px;
    }

    .phrase-brain {
      height: 340px;
    }

    .phrase-container {
      padding-block: 0;
      text-align: center;
    }
  }
</style>

<script>
  // ---------------------------------------------------------------------------
  // Scroll word reveal — words illuminate as the phrase scrolls through view.
  // ---------------------------------------------------------------------------
  const container = document.querySelector<HTMLElement>(".phrase-container");
  const words = Array.from(
    document.querySelectorAll<HTMLElement>(".phrase-word"),
  );

  if (container && words.length) {
    let ticking = false;

    const updateWords = () => {
      ticking = false;
      const rect = container.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      const startTrigger = windowHeight * 0.75;
      const endTrigger = windowHeight * 0.25;

      const progress = (startTrigger - rect.top) / (startTrigger - endTrigger);
      const clamped = Math.max(0, Math.min(1, progress));

      words.forEach((word, i) => {
        const threshold = i / (words.length - 1);
        word.classList.toggle("active", clamped >= threshold);
      });
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateWords);
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    updateWords();

    const cleanup = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
    };
    document.addEventListener("astro:before-swap", cleanup, { once: true });
    window.addEventListener("beforeunload", cleanup, { once: true });
  }
</script>
