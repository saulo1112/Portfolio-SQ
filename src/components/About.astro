---
import { Image } from "astro:assets";
import profilePicture from "../assets/Profile picture.png";
---

<section class="about" id="about">
  <div class="inner">
    <!-- ---- Left column: photo card ---- -->
    <div class="left">
      <div class="card" id="about-card">
        <Image
          class="photo"
          src={profilePicture}
          alt="Portrait of Saulo Quiñones"
          widths={[280, 473, 946]}
          sizes="(max-width: 768px) 280px, 473px"
          quality={90}
          loading="lazy"
        />
      </div>

      <div class="badge">
        <span class="dot" aria-hidden="true"></span>
        <span class="badge-text">Available for remote work</span>
      </div>
    </div>

    <!-- ---- Right column: content ---- -->
    <div class="right" id="about-right">
      <p class="eyebrow">ABOUT</p>

      <h2 class="heading">
        Hi, I'm Saulo Quiñones. Environmental engineer, software builder.
      </h2>

      <p class="para">
        I work across three areas, web development, GIS, and applied AI, and I'm comfortable picking up whatever a project needs, from a shipped interface to a machine learning pipeline. I'm an environmental engineer who has applied most of this to real world problems, and I carry that same mix of data, logic, and design into any team that needs it.
      </p>

      <p class="para">
        I'm strongest with spatial databases and geoprocessing, backend services in Python and Node.js, and machine learning across computer vision, time series, and accessibility tools. On the frontend I work with React and Astro. Right now I'm deep in geospatial data engineering and interactive web mapping, turning data from multiple sources into tools people actually use.
      </p>

      <div class="stats" id="about-stats">
        <div class="stat">
          <span class="stat-num" data-target="10" data-format="int-plus">0</span>
          <span class="stat-label">Projects built</span>
        </div>
        <div class="stat">
          <span class="stat-num" data-target="3" data-format="comma">0</span>
          <span class="stat-label">Domains, one skill set</span>
        </div>
      </div>

      <p class="languages">
        <span class="lang-label">Languages:</span> Spanish (native) · English (C2)
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    overflow: clip;
    padding: 96px 24px;
    border-top: 1px solid var(--color-border);
  }

  .inner {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 45% 55%;
    align-items: start;
    gap: 48px;
  }

  /* ---- Left column ---- */
  .left {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card {
    position: relative;
    /* Matches the portrait's native 3:4 crop exactly, so the frame shows the
       whole photo with no cropping instead of the fixed height tuned for the
       previous full-body placeholder. */
    aspect-ratio: 3 / 4;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    overflow: hidden;
    transform: perspective(800px) rotateX(0deg) rotateY(0deg) scale(1);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    will-change: transform;
  }

  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 80%: anchors the crop near the bottom of the source, so the shorter
       card (see height-sync script below) trims mostly the empty background
       above the hairline instead of the shoulders, keeping the face centered.
       Raise this value (toward 100%) to trim more off the top; lower it
       (toward 50%) to trim more off the bottom. */
    object-position: center 55%;
    filter: grayscale(100%);
    transition: filter 0.4s ease;
  }

  .card:hover .photo {
    filter: grayscale(0%);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px 2px rgba(29, 158, 117, 0.2);
  }

  .badge-text {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
  }

  /* ---- Right column ---- */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 20px;
  }

  .heading {
    font-size: 28px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin-bottom: 24px;
  }

  .para {
    max-width: 540px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
  }

  /* ---- Stats grid ---- */
  .stats {
    margin-top: 16px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .stat {
    padding: 24px;
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  /* Remove the outer borders so only internal dividers show. */
  .stat:nth-child(1),
  .stat:nth-child(2) {
    border-top: none;
  }

  .stat:nth-child(odd) {
    border-left: none;
  }

  .stat-num {
    display: block;
    font-size: 32px;
    font-weight: 500;
    line-height: 1;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    display: block;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  /* ---- Languages ---- */
  .languages {
    margin-top: 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .lang-label {
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .about {
      padding: 64px 24px;
    }

    .inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .card {
      max-width: 280px;
      margin: 0 auto;
    }
  }
</style>

<script>
  // Three.js is only downloaded when the About section enters the viewport,
  // keeping it out of the initial JS bundle.
  const section = document.getElementById("about") as HTMLElement | null;

  if (section) {
    const initThree = async () => {
      const THREE = await import("three");
      const { RoomEnvironment } = await import("three/addons/environments/RoomEnvironment.js");

    // ---------------------------------------------------------------------------
    // Floating 3D geometric objects background (Three.js)
    // ---------------------------------------------------------------------------
    const ACCENT = 0x1d9e75;
    const rand = (min: number, max: number) =>
      min + Math.random() * (max - min);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    // ---- Renderer ----
    const renderer = new THREE.WebGLRenderer({
      alpha: true,
      antialias: true,
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    const dom = renderer.domElement;
    dom.id = "about-three-canvas";
    dom.style.position = "absolute";
    dom.style.top = "0";
    dom.style.left = "0";
    dom.style.width = "100%";
    dom.style.height = "100%";
    dom.style.zIndex = "0";
    dom.style.pointerEvents = "none";
    section.appendChild(dom);

    // ---- Scene & camera ----
    const scene = new THREE.Scene();
    let width = section.clientWidth;
    let height = section.clientHeight;
    const camera = new THREE.PerspectiveCamera(60, width / height, 0.1, 1000);
    camera.position.z = 20;
    // updateStyle=false so our 100%/100% CSS controls layout, not inline px.
    renderer.setSize(width, height, false);

    // ---- Environment map ----
    // Metallic materials need something to reflect; a neutral PMREM environment
    // turns them from flat near-black into polished silver catching the lights.
    const pmremGenerator = new THREE.PMREMGenerator(renderer);
    pmremGenerator.compileEquirectangularShader();
    const neutralEnv = pmremGenerator.fromScene(
      new RoomEnvironment(),
      0.04,
    ).texture;
    scene.environment = neutralEnv;
    scene.background = null; // keep section background showing through (alpha:true)
    pmremGenerator.dispose();

    // ---- Lighting ----
    const ambient = new THREE.AmbientLight(0xffffff, 0.15);
    scene.add(ambient);

    const directional = new THREE.DirectionalLight(0xffffff, 2.0);
    directional.position.set(8, 12, 10);
    directional.castShadow = false;
    scene.add(directional);

    // Teal fill from the left — base position is animated each frame.
    const pointA = new THREE.PointLight(0x1d9e75, 3.5, 30);
    pointA.position.set(-12, 6, 8);
    scene.add(pointA);

    // White rim from bottom right — follows the mouse in world space.
    const pointB = new THREE.PointLight(0xffffff, 1.2, 25);
    const pointBBase = new THREE.Vector3(10, -8, 6);
    pointB.position.copy(pointBBase);
    scene.add(pointB);

    // Darker teal underlight for depth.
    const pointC = new THREE.PointLight(0x0f6e56, 1.5, 20);
    pointC.position.set(0, -10, 4);
    scene.add(pointC);

    // ---- Geometry pool (6 types) ----
    const geometries = [
      new THREE.SphereGeometry(1, 32, 32),
      new THREE.BoxGeometry(1.5, 1.5, 1.5),
      new THREE.OctahedronGeometry(1.2),
      new THREE.IcosahedronGeometry(1.2),
      new THREE.TorusGeometry(0.9, 0.35, 16, 32),
      new THREE.TetrahedronGeometry(1.3),
    ];

    type FloatObject = {
      mesh: THREE.Mesh;
      material: THREE.MeshStandardMaterial;
      floatSpeed: number;
      floatAmplitude: number;
      rotationSpeedX: number;
      rotationSpeedY: number;
      originalY: number;
      baseScale: number;
      scaleMul: number;
      isRecessed: boolean;
    };

    const objects: FloatObject[] = [];
    const ACTIVE_EMISSIVE = new THREE.Color(ACCENT);
    const BLACK = new THREE.Color(0x000000);

    // Depth (not opacity) controls prominence. Three zones, 18 objects total:
    // 8 left (prominent), 4 center (recessed), 6 right (far back, small).
    type Zone = {
      x: () => number;
      z: () => number;
      scale: () => number;
      count: number;
    };
    const zones: Zone[] = [
      // Left zone — x < -3, well-lit and forward.
      { x: () => rand(-20, -3), z: () => rand(-2, 3), scale: () => rand(0.8, 2.2), count: 8 },
      // Center zone — recessed behind the content.
      { x: () => rand(-3, 3), z: () => rand(-8, -4), scale: () => rand(0.5, 1.0), count: 4 },
      // Right zone — far back and small so it never competes with text.
      { x: () => rand(3, 20), z: () => rand(-10, -6), scale: () => rand(0.4, 0.8), count: 6 },
    ];

    for (const zone of zones) {
      for (let i = 0; i < zone.count; i++) {
        const geometry =
          geometries[Math.floor(Math.random() * geometries.length)];
        const material = new THREE.MeshStandardMaterial({
          color: 0x888888,
          metalness: 1.0,
          roughness: 0.05,
          envMapIntensity: 1.0,
          transparent: false,
          opacity: 1.0,
        });
        material.emissive = new THREE.Color(0x000000);

        const mesh = new THREE.Mesh(geometry, material);

        const baseScale = zone.scale();
        mesh.scale.setScalar(baseScale);

        const px = zone.x();
        let py = rand(-10, 10);
        // Keep side-zone objects out of the cut-off top corners.
        if ((px < -3 || px > 3) && py > 7) {
          py = rand(-7, 5);
        }
        // Keep the area directly above the heading text clear.
        if (px > -1 && px < 1 && py > 4) {
          py = rand(-7, 4);
        }
        mesh.position.set(px, py, zone.z());

        // Far side-zone objects (both left & right) become a dim, recessed
        // background so the hand-placed featured shapes read as prominent.
        // Center objects (x in [-3, 2], over the text) keep their bright look.
        if (px > 2 || px < -3) {
          material.color = new THREE.Color(0x2a2a2a);
          material.metalness = 0.6;
          material.roughness = 0.4;
          mesh.position.z = rand(-12, -8);
        }
        mesh.rotation.set(
          rand(0, Math.PI * 2),
          rand(0, Math.PI * 2),
          rand(0, Math.PI * 2),
        );

        scene.add(mesh);

        objects.push({
          mesh,
          material,
          floatSpeed: rand(0.3, 0.8),
          floatAmplitude: rand(0.3, 0.8),
          rotationSpeedX: rand(0.001, 0.004),
          rotationSpeedY: rand(0.001, 0.004),
          originalY: mesh.position.y,
          baseScale,
          scaleMul: 1,
          isRecessed: px > 2 || px < -3,
        });
      }
    }

    // ---- Featured (hand-placed, deterministic) objects ----
    // Fixed bright-silver shapes at the four outer edges, clear of the text.
    // They reuse pool geometries and join objects[] so they inherit the float,
    // rotation, mouse-hover and per-object cleanup.
    const addFeatured = (
      geometry: THREE.BufferGeometry,
      x: number,
      y: number,
      z: number,
      baseScale: number,
    ) => {
      const material = new THREE.MeshStandardMaterial({
        color: 0x888888,
        metalness: 1.0,
        roughness: 0.05,
        envMapIntensity: 1.0,
        transparent: false,
        opacity: 1.0,
      });
      material.emissive = new THREE.Color(0x000000);

      const mesh = new THREE.Mesh(geometry, material);
      mesh.scale.setScalar(baseScale);
      mesh.position.set(x, y, z);
      mesh.rotation.set(
        rand(0, Math.PI * 2),
        rand(0, Math.PI * 2),
        rand(0, Math.PI * 2),
      );
      scene.add(mesh);

      objects.push({
        mesh,
        material,
        floatSpeed: rand(0.3, 0.6),
        floatAmplitude: rand(0.3, 0.5),
        rotationSpeedX: rand(0.001, 0.003),
        rotationSpeedY: rand(0.001, 0.003),
        originalY: y,
        baseScale,
        scaleMul: 1,
        isRecessed: false,
      });
    };

    //[Horizontal, Vertical, Depth]

    addFeatured(geometries[4], -18.3, 4.5, 2, 1.7); // torus  — upper-left
    addFeatured(geometries[3], -18.4, -4.0, 2, 1.7); // icosa  — lower-left
    addFeatured(geometries[1], 19, 3, 2, 1.2); // cube   — upper-right
    addFeatured(geometries[0], 20.7, -6.0, 0.5, 1.4); // sphere — lower-right

    // ---- Mouse / raycaster ----
    const mouseNdc = new THREE.Vector2(-10, -10); // off-screen until first move
    let mouseActive = false;
    const raycaster = new THREE.Raycaster();
    const HOVER_DIST = 2.5; // ray-to-center proximity threshold (world units)

    const onMouseMove = (e: MouseEvent) => {
      const rect = section.getBoundingClientRect();
      mouseNdc.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouseNdc.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
      mouseActive = true;
    };
    const onMouseLeave = () => {
      mouseNdc.set(-10, -10);
      mouseActive = false;
    };
    section.addEventListener("mousemove", onMouseMove);
    section.addEventListener("mouseleave", onMouseLeave);

    // ---- Animation loop ----
    const clock = new THREE.Clock();
    let rafId = 0;

    // Scratch vectors reused each frame (avoids per-frame allocations).
    const mouseWorld = new THREE.Vector3();
    const pointBTarget = new THREE.Vector3();
    const projVec = new THREE.Vector3(); // reused for screen-space projection
    const clampOffset = (v: number, base: number, max: number) =>
      Math.max(base - max, Math.min(base + max, v));

    const animate = () => {
      rafId = requestAnimationFrame(animate);
      const time = clock.getElapsedTime();

      // Animate the teal fill light so reflections shift and feel alive.
      pointA.position.x = -12 + Math.sin(time * 0.4) * 3;
      pointA.position.y = 6 + Math.cos(time * 0.3) * 2;

      raycaster.setFromCamera(mouseNdc, camera);

      // Move the white rim light (point B) toward the cursor in world space.
      if (mouseActive) {
        // Project the ray onto the plane z = pointB base depth.
        const dir = raycaster.ray.direction;
        const t = (pointBBase.z - raycaster.ray.origin.z) / dir.z;
        raycaster.ray.at(t, mouseWorld);
        pointBTarget.set(
          clampOffset(mouseWorld.x, pointBBase.x, 8),
          clampOffset(mouseWorld.y, pointBBase.y, 8),
          pointBBase.z,
        );
      } else {
        pointBTarget.copy(pointBBase);
      }
      pointB.position.lerp(pointBTarget, 0.05);

      for (const o of objects) {
        const { mesh, material } = o;

        // Float + spin.
        mesh.position.y =
          o.originalY + Math.sin(time * o.floatSpeed) * o.floatAmplitude;
        mesh.rotation.x += o.rotationSpeedX;
        mesh.rotation.y += o.rotationSpeedY;

        // Screen-space opacity — objects over the right text column fade to
        // semi-transparent so they never compete with the heading/copy.
        projVec.copy(mesh.position).project(camera);
        const screenFrac = (projVec.x + 1) / 2; // 0 = left edge, 1 = right edge
        const inRightZone = screenFrac > 0.48;
        const opacityTarget = inRightZone ? (o.isRecessed ? 0.15 : 0.25) : 1.0;
        material.transparent = true;
        material.opacity = lerp(material.opacity, opacityTarget, 0.04);
        // Turn transparent back off once fully opaque to avoid z-sorting cost.
        if (!inRightZone && material.opacity > 0.99) {
          material.transparent = false;
          material.opacity = 1.0;
        }

        // Proximity to mouse ray → scale + emissive boost.
        const near = raycaster.ray.distanceToPoint(mesh.position) < HOVER_DIST;
        const targetMul = near ? 1.2 : 1;
        o.scaleMul = lerp(o.scaleMul, targetMul, 0.1);
        mesh.scale.setScalar(o.baseScale * o.scaleMul);

        material.emissive.lerp(near ? ACTIVE_EMISSIVE : BLACK, 0.1);
        material.emissiveIntensity = near ? 0.4 : material.emissiveIntensity;
      }

      renderer.render(scene, camera);
    };
    animate();

    // ---- Resize ----
    const onResize = () => {
      width = section.clientWidth;
      height = section.clientHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
    };
    window.addEventListener("resize", onResize);

    // ---- Cleanup (unmount / SPA navigation) ----
    const cleanup = () => {
      cancelAnimationFrame(rafId);
      window.removeEventListener("resize", onResize);
      section.removeEventListener("mousemove", onMouseMove);
      section.removeEventListener("mouseleave", onMouseLeave);
      geometries.forEach((g) => g.dispose());
      objects.forEach((o) => o.material.dispose());
      neutralEnv.dispose();
      scene.environment = null;
      renderer.dispose();
      dom.remove();
    };
    document.addEventListener("astro:before-swap", cleanup, { once: true });
    window.addEventListener("beforeunload", cleanup, { once: true });
  };

  // Download and init Three.js only when the section nears the viewport.
  const threeObserver = new IntersectionObserver(
    (entries) => {
      if (entries[0].isIntersecting) {
        threeObserver.disconnect();
        initThree();
      }
    },
    { rootMargin: "200px" },
  );
  threeObserver.observe(section);
  }

  // ---------------------------------------------------------------------------
  // Photo card 3D tilt
  // ---------------------------------------------------------------------------
  const card = document.getElementById("about-card") as HTMLElement | null;
  if (card) {
    const MAX_TILT = 8;

    card.addEventListener("mousemove", (e) => {
      const rect = card.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const dx = (e.clientX - cx) / (rect.width / 2); // -1 .. 1
      const dy = (e.clientY - cy) / (rect.height / 2); // -1 .. 1

      const rotateY = dx * MAX_TILT;
      const rotateX = -dy * MAX_TILT;

      card.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
      // Shadow shifts opposite to the tilt to simulate depth lighting.
      card.style.boxShadow = `${-dx * 20}px ${-dy * 20}px 40px rgba(29, 158, 117, 0.15)`;
    });

    card.addEventListener("mouseleave", () => {
      card.style.transform =
        "perspective(800px) rotateX(0deg) rotateY(0deg) scale(1)";
      card.style.boxShadow = "none";
    });
  }

  // ---------------------------------------------------------------------------
  // Photo card height sync
  // ---------------------------------------------------------------------------
  // CSS alone can't do this: Grid only ever *grows* the shorter column to
  // match the taller one, never shrinks the taller one down. The card's own
  // aspect-ratio (3:4) renders taller than the About copy, so its height is
  // pinned here to the right column's actual rendered height instead. The photo
  // is anchored low (object-position: center 80% on .photo) so shrinking this
  // box trims mostly empty background above the head. Below the 768px breakpoint
  // the columns stack and the
  // card falls back to its CSS aspect-ratio.
  const rightCol = document.getElementById("about-right") as HTMLElement | null;
  const leftCol = document.querySelector<HTMLElement>(".about .left");
  const badge = document.querySelector<HTMLElement>(".about .badge");

  if (card && rightCol && leftCol && badge) {
    const syncCardHeight = () => {
      if (window.innerWidth <= 768) {
        card.style.height = ""; // let the aspect-ratio drive mobile sizing
        return;
      }
      const gap = parseFloat(getComputedStyle(leftCol).rowGap || "0");
      const target = rightCol.offsetHeight - badge.offsetHeight - gap;
      card.style.height = `${Math.max(target, 200)}px`;
    };

    syncCardHeight();
    window.addEventListener("resize", syncCardHeight);
    // Web fonts can swap in after first paint and change the copy's line
    // count; re-measure once they've settled.
    document.fonts?.ready?.then(syncCardHeight);
  }

  // ---------------------------------------------------------------------------
  // Stats count-up on scroll into view
  // ---------------------------------------------------------------------------
  const stats = document.getElementById("about-stats");
  if (stats) {
    const easeOutQuart = (t: number) => 1 - Math.pow(1 - t, 4);

    const formatValue = (value: number, format: string | null): string => {
      switch (format) {
        case "comma":
          return Math.round(value).toLocaleString("en-US");
        case "decimal3":
          return value.toFixed(3);
        case "score":
          return value.toFixed(1) + "/5";
        case "int-plus":
          return String(Math.round(value)) + "+";
        case "int":
        default:
          return String(Math.round(value));
      }
    };

    const runCountUp = () => {
      const nums = stats.querySelectorAll<HTMLElement>(".stat-num");
      const duration = 1200;
      const start = performance.now();

      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = easeOutQuart(t);
        nums.forEach((el) => {
          const target = parseFloat(el.dataset.target || "0");
          const fmt = el.dataset.format || "int";
          el.textContent = formatValue(target * eased, fmt);
        });
        if (t < 1) requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            runCountUp();
            observer.disconnect();
            break;
          }
        }
      },
      { threshold: 0.3 },
    );

    observer.observe(stats);
  }
</script>
