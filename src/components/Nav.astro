---
const links = [
  { label: "Work", href: "#work" },
  { label: "Stack", href: "#stack" },
  { label: "Experience", href: "#experience" },
  { label: "Contact", href: "#contact" },
];
---

<header class="nav" id="site-nav" data-scrolled="false">
  <div class="inner">
    <a class="brand" href="#top">saulo.dev</a>

    <nav class="links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="controls">
      <button
        class="hamburger"
        id="nav-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile" hidden>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .nav[data-scrolled="true"] {
    background-color: var(--color-surface);
    border-bottom-color: var(--color-border);
  }

  .inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-left: auto;
  }

  .links a {
    font-size: 13px;
    color: var(--color-text-secondary);
    transition: color 0.15s ease;
  }

  .links a:hover {
    color: var(--color-text-primary);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hamburger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-control);
    color: var(--color-text-secondary);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .hamburger:hover {
    color: var(--color-text-primary);
    background-color: var(--color-surface);
  }

  .hamburger {
    display: none;
  }

  .mobile-menu {
    display: none;
    flex-direction: column;
    padding: 8px 24px 16px;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-menu a {
    padding: 12px 0;
    font-size: 15px;
    color: var(--color-text-secondary);
    border-top: 1px solid var(--color-border);
  }

  .mobile-menu a:first-child {
    border-top: none;
  }

  @media (max-width: 768px) {
    .links {
      display: none;
    }
    .hamburger {
      display: inline-flex;
    }
    .mobile-menu[data-open="true"] {
      display: flex;
    }
  }
</style>

<script>
  const nav = document.getElementById("site-nav");
  const navToggle = document.getElementById("nav-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  // Solid background once the page is scrolled.
  const onScroll = () => {
    if (nav) nav.dataset.scrolled = window.scrollY > 0 ? "true" : "false";
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Mobile menu open/close.
  const setMenu = (open: boolean) => {
    if (!mobileMenu || !navToggle) return;
    mobileMenu.hidden = !open;
    mobileMenu.dataset.open = String(open);
    navToggle.setAttribute("aria-expanded", String(open));
  };
  navToggle?.addEventListener("click", () => {
    setMenu(mobileMenu?.dataset.open !== "true");
  });
  // Close the menu after tapping a link.
  mobileMenu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setMenu(false))
  );
</script>
