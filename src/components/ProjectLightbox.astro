---
import { Image } from "astro:assets";
import type { ProjectDetail } from "../data/projectDetails";

interface Props {
  slug: string;
  detail: ProjectDetail;
}

const { slug, detail } = Astro.props;

// The gallery layout follows each screenshot's own proportions instead of a
// declared ratio, so nothing is ever cropped or stretched:
//   wide  - desktop capture (~2.11 here), takes a full row
//   tall  - phone capture (~0.45), sits alongside its siblings
//   doc   - a page-shaped export (~0.77), centred at a readable width
// The 0.6 cut-off sits in the gap between a phone screen and a printed page;
// anything squarer than that is a document and must not be shrunk to phone width.
const modeOf = (w: number, h: number) => {
  const r = w / h;
  if (r >= 1.5) return "wide";
  if (r <= 0.6) return "tall";
  return "doc";
};

// Four phone screenshots read better as 2x2 than as a row of 3 with an orphan.
const tallCount = detail.figures.filter(
  (f) => modeOf(f.src.width, f.src.height) === "tall",
).length;
const tallPerRow = tallCount === 4 ? 2 : 3;

const SIZES = {
  wide: "(max-width: 860px) 92vw, 912px",
  tall: "(max-width: 700px) 45vw, 288px",
  doc: "(max-width: 620px) 90vw, 520px",
} as const;

// The largest step in each list requests more pixels than most sources need;
// Astro clamps automatically to each image's real width (verified: no upscale,
// no build error), so this just guarantees full native resolution is offered
// to high-DPI screens instead of an arbitrary cap that left retina displays
// upscaling a soft 1400px source, most visible on text-dense screenshots.
const WIDTHS = {
  wide: [640, 960, 1920],
  tall: [300, 600, 900],
  doc: [520, 1040, 1700],
} as const;
---

<dialog class="lb" id={`lb-${slug}`} style={`--accent: ${detail.accent};`}>
  <button class="lb-close" data-lb-close aria-label="Close overview">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M6 6l12 12M18 6L6 18"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"></path>
    </svg>
  </button>

  <article class="lb-body">
    <header class="lb-head">
      <div class="lb-tags">
        {
          detail.tags.map((t, i) => (
            <span class={i === 0 ? "lb-tag lb-tag-accent" : "lb-tag"}>{t}</span>
          ))
        }
      </div>
      <h2 class="lb-title">{detail.title}</h2>
      <p class="lb-tagline">{detail.tagline}</p>

      <div class="lb-actions">
        {detail.github && (
          <a class="lb-gh" href={detail.github} target="_blank" rel="noopener">
            View on GitHub ↗
          </a>
        )}
        {detail.live && (
          <a class="lb-gh" href={detail.live.href} target="_blank" rel="noopener">
            {detail.live.label}
          </a>
        )}
        <span class="lb-stack">{detail.stack}</span>
      </div>
      {detail.liveNote && <p class="lb-live-note">{detail.liveNote}</p>}
    </header>

    <dl class="lb-facts">
      {
        detail.facts.map((f) => (
          <div class="lb-fact">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="lb-metrics">
      {
        detail.metrics.map((m) => (
          <div class="lb-metric">
            <span class="lb-metric-value">{m.value}</span>
            <span class="lb-metric-label">{m.label}</span>
          </div>
        ))
      }
    </div>

    <div class="lb-sections">
      {
        detail.sections.map((s) => (
          <section class="lb-section">
            <h3 class="lb-h3">{s.heading}</h3>
            {s.body.map((p) => (
              <p class="lb-p">{p}</p>
            ))}
          </section>
        ))
      }
    </div>

    {
      detail.video && (
        <section class="lb-media">
          <h3 class="lb-h3">Demo video</h3>
          <div class="lb-video" data-yt={detail.video.youtubeId}>
            <button
              type="button"
              class="lb-video-btn"
              aria-label={`Play the ${detail.title} demo video`}
            >
              <img
                src={`https://i.ytimg.com/vi/${detail.video.youtubeId}/maxresdefault.jpg`}
                alt=""
                loading="lazy"
                decoding="async"
                onerror={`this.onerror=null;this.src='https://i.ytimg.com/vi/${detail.video.youtubeId}/sddefault.jpg'`}
              />
              <span class="lb-video-shade" aria-hidden="true" />
              <span class="lb-video-head" aria-hidden="true">
                <span class="lb-video-avatar">S</span>
                <span class="lb-video-meta">
                  <strong>{detail.title}</strong>
                  <span>Saulo Quiñones Góngora</span>
                </span>
              </span>
              <span class="lb-video-play" aria-hidden="true" />
              <span class="lb-video-yt" aria-hidden="true">
                Watch on
                <svg width="29" height="20" viewBox="0 0 68 48">
                  <path
                    d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.2 34 .2 34 .2S12.8.2 7.5 1.7a8.5 8.5 0 0 0-6 6C0 13 0 24 0 24s0 11 1.5 16.3a8.5 8.5 0 0 0 6 6C12.8 47.8 34 47.8 34 47.8s21.2 0 26.5-1.5a8.5 8.5 0 0 0 6-6C68 35 68 24 68 24s0-11-1.5-16.3z"
                    fill="#fff"
                  />
                  <path d="M45 24 27 14v20" fill="#000" />
                </svg>
                YouTube
              </span>
            </button>
          </div>
        </section>
      )
    }

    {
      detail.figures.length > 0 && (
        <section class="lb-media">
        <h3 class="lb-h3">Screenshots</h3>
        <div class="lb-gallery" style={`--tall-per-row: ${tallPerRow};`}>
          {
            detail.figures.map((f) => {
              const mode = modeOf(f.src.width, f.src.height);
              return (
                <figure class={`lb-fig lb-fig--${mode}`}>
                  <Image
                    src={f.src}
                    alt={f.caption}
                    widths={[...WIDTHS[mode]]}
                    sizes={SIZES[mode]}
                    format="png"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="lb-fig-cap">{f.caption}</figcaption>
                </figure>
              );
            })
          }
        </div>
        </section>
      )
    }
  </article>
</dialog>

<style>
  .lb {
    /* Sized as a panel, not a full page — the backdrop stays visible at the edges. */
    width: min(1040px, 92vw);
    max-height: 88vh;
    /* The global reset (* { margin: 0 }) overrides the UA stylesheet's
       `dialog { margin: auto }`, which is what centres a modal inside its
       inset:0 box — without this the panel pins to the top-left corner. */
    margin: auto;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--color-border));
    border-radius: 20px;
    background: var(--color-bg);
    color: var(--color-text-primary);
    overflow: hidden;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 10%, transparent),
      0 40px 80px rgba(0, 0, 0, 0.5);
  }

  .lb::backdrop {
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(4px);
  }

  /* Entry animation — only when opened, and skipped for reduced-motion users. */
  .lb[open] {
    animation: lb-in 0.22s ease-out;
  }
  .lb[open]::backdrop {
    animation: lb-fade 0.22s ease-out;
  }

  @keyframes lb-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.985);
    }
  }
  @keyframes lb-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lb[open],
    .lb[open]::backdrop {
      animation: none;
    }
  }

  .lb-body {
    max-height: 88vh;
    overflow-y: auto;
    padding: 48px clamp(24px, 5vw, 64px) 56px;
    /* A hairline of accent across the top edge. */
    background:
      linear-gradient(
          color-mix(in srgb, var(--accent) 7%, transparent),
          transparent 320px
        )
        no-repeat;
  }

  /* ---- Close ---- */
  .lb-close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 5;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 99px;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(8px);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .lb-close:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-muted);
  }

  .lb-close svg {
    width: 18px;
    height: 18px;
  }

  /* ---- Header ---- */
  .lb-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .lb-tag {
    font-size: 11px;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: 99px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .lb-tag-accent {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    color: var(--accent);
  }

  .lb-title {
    margin: 18px 0 0;
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .lb-tagline {
    margin: 16px 0 0;
    max-width: 68ch;
    font-size: clamp(16px, 1.7vw, 19px);
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .lb-actions {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }

  .lb-gh {
    flex-shrink: 0;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 99px;
    padding: 9px 18px;
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .lb-gh:hover {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-color: var(--accent);
  }

  /* ---- Demo video ----
     A sharp poster dressed like YouTube's own player (title, channel, play,
     "Watch on YouTube"); the real player replaces it on click. YouTube's
     embed poster is low-resolution, which is why it isn't shown up front. */
  .lb-video {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: #000;
  }

  .lb-video-btn {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: #000;
    color: #fff;
    cursor: pointer;
    text-align: left;
  }

  .lb-video-btn img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lb-video-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(0, 0, 0, 0.75), transparent 22%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.75), transparent 20%);
  }

  .lb-video-head {
    position: absolute;
    top: 18px;
    left: 30px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .lb-video-avatar {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #fd5a1f;
    font-size: 18px;
  }

  .lb-video-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    font-size: 12px;
  }

  .lb-video-meta strong {
    font-size: 20px;
    font-weight: 700;
  }

  .lb-video-play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 68px;
    height: 48px;
    transform: translate(-50%, -50%);
    border-radius: 14px;
    background: #f03;
    transition: transform 0.2s ease;
  }

  .lb-video-play::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-40%, -50%);
    border-style: solid;
    border-width: 10px 0 10px 18px;
    border-color: transparent transparent transparent #fff;
  }

  .lb-video-btn:hover .lb-video-play {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .lb-video-yt {
    position: absolute;
    right: 30px;
    bottom: 16px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .lb-video-yt svg {
    width: 29px;
    height: 20px;
  }

  .lb-video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 600px) {
    .lb-video-head {
      top: 10px;
      left: 12px;
      gap: 8px;
    }

    .lb-video-avatar {
      width: 28px;
      height: 28px;
      font-size: 14px;
    }

    .lb-video-meta {
      font-size: 10px;
    }

    .lb-video-meta strong {
      font-size: 14px;
    }

    .lb-video-yt {
      right: 12px;
      bottom: 8px;
      font-size: 13px;
    }

    .lb-video-yt svg {
      width: 22px;
      height: 15px;
    }
  }

  .lb-live-note {
    margin-top: 10px;
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .lb-stack {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
  }

  /* ---- Facts strip ---- */
  .lb-facts {
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
  }

  .lb-fact {
    padding: 16px 18px;
    background: var(--color-bg);
  }

  .lb-fact dt {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-muted);
  }

  .lb-fact dd {
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--color-text-primary);
  }

  /* ---- Metrics ---- */
  .lb-metrics {
    margin-top: 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px;
  }

  .lb-metric {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 18px;
    border-top: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .lb-metric-value {
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--accent);
  }

  .lb-metric-label {
    font-size: 12px;
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  /* ---- Narrative ---- */
  .lb-sections {
    margin-top: 48px;
    display: grid;
    gap: 32px;
  }

  .lb-section {
    display: block;
  }

  .lb-h3 {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .lb-p {
    margin: 0;
    font-size: 15px;
    line-height: 1.72;
    color: var(--color-text-secondary);
    text-align: justify;
    hyphens: auto;
    text-wrap: pretty;
  }

  .lb-p + .lb-p {
    margin-top: 14px;
  }

  /* ---- Gallery ----
     Flex-wrap does the grouping: a wide figure claims its own row, phone-shaped
     ones share a row. Items are sized from a fixed basis rather than flex-grow
     so a short final row keeps the same widths as a full one. */
  .lb-media {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--color-border);
  }

  .lb-media .lb-h3 {
    margin-bottom: 20px;
  }

  .lb-gallery {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
  }

  .lb-fig {
    margin: 0;
  }

  .lb-fig--wide {
    flex: 1 1 100%;
  }

  .lb-fig--tall {
    flex: 0 1
      calc(
        (100% - (var(--tall-per-row) - 1) * 24px) / var(--tall-per-row)
      );
    min-width: 170px;
  }

  .lb-fig--doc {
    flex: 1 1 100%;
    max-width: 520px;
  }

  /* No aspect-ratio box and no object-fit: the image keeps its own proportions. */
  .lb-fig :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent) 6%, var(--color-surface));
    box-shadow: inset 0 0 0 1.5px
      color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .lb-fig-cap {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  /* ---- Responsive ---- */
  @media (max-width: 860px) {
    .lb-facts {
      grid-template-columns: repeat(2, 1fr);
    }
    .lb-fig--tall {
      flex-basis: calc((100% - 24px) / 2);
    }
  }

  @media (max-width: 560px) {
    .lb {
      width: 100vw;
      max-height: 100dvh;
      border-radius: 0;
      border: none;
    }
    .lb-body {
      max-height: 100dvh;
      padding: 56px 20px 40px;
    }
    .lb-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
