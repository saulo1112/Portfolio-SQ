---
import eudrVideo from "../assets/Videos/EUDR Hero Animation.mp4";
import fudambientVideo from "../assets/Videos/Fudambient.mp4";
import physicalRecoveryVideo from "../assets/Videos/App Physical Recovery.mp4";
import optiCoderVideo from "../assets/Videos/OptiCoder Hero.mp4";
import { Image } from "astro:assets";
import ProjectLightbox from "./ProjectLightbox.astro";
import { projectDetails } from "../data/projectDetails";

// Card thumbnail: the project's own `card` override when its lead screenshot
// would survive the crop badly, otherwise the first figure.
const thumbOf = (slug: string) => {
  const d = projectDetails[slug];
  return d ? (d.card ?? d.figures[0].src) : undefined;
};

const featured = [
  {
    title: "EUDR Forest Risk Assessment",
    tags: ["GIS", "Machine learning", "FastAPI"],
    problem:
      "How do you screen 4,170 real agricultural parcels for EU deforestation compliance — using only open satellite data?",
    stack: "Python · PostGIS · Earth Engine · scikit-learn · Docker",
    github: "https://github.com/saulo1112/EUDR_Risk_Assessment",
    caseStudy: "/projects/eudr-risk-assessment",
    slug: "eudr",
    video: eudrVideo,
    accent: "#1D9E75",
    fit: "fill",
    zoom: 1,
  },
  {
    title: "Fudambient",
    tags: ["Web", "Client work"],
    problem:
      "Designing and building the institutional website for an environmental NGO — from information architecture to launch.",
    stack: "HTML · CSS · JavaScript",
    github: "https://github.com/saulo1112/Fudambient-Page",
    caseStudy: null,
    slug: "fudambient",
    video: fudambientVideo,
    accent: "#aaf683",
    fit: "contain",
    zoom: 1.34,
  },
  {
    title: "App Physical Recovery",
    tags: ["AI/ML", "Computer vision", "Deep learning"],
    problem:
      "Can two deep learning models — person detection and pose estimation — turn a phone camera into a physiotherapy coach?",
    stack: "PyTorch · HuggingFace · gRPC · Streamlit · Docker",
    // TODO: update with saulo1112 fork URL
    github: "https://github.com/miguelfrancor01/App_PhysicalRecovery",
    caseStudy: null,
    slug: "physical-recovery",
    video: physicalRecoveryVideo,
    accent: "#ffb3c1",
  },
  {
    title: "OptiCoder",
    tags: ["Mobile", "React Native"],
    problem:
      "Code screenshots, UI mockups and architecture diagrams carry no alt text. Can a phone camera read them aloud for developers who can't see them?",
    stack: "React Native · Expo · Gemini · Whisper",
    github: "https://github.com/saulo1112/PDproject",
    caseStudy: null,
    slug: "opticoder",
    video: optiCoderVideo,
    accent: "#0057A4",
  },
];

const small = [
  {
    title: "Site Selection Engine",
    tags: ["GIS", "Spatial ML"],
    github: "https://github.com/saulo1112/Site_selection_engine",
    slug: "site-selection",
    accent: "#1D9E75",
  },
  {
    title: "Cauca River Baseline",
    tags: ["GIS", "Python"],
    github: "https://github.com/saulo1112/RioCauca_Baseline",
    slug: "riocauca-baseline",
    accent: "#4EA8DE",
  },
  {
    title: "Cali River Biomonitoring",
    tags: ["Machine learning", "Research"],
    github: "https://github.com/saulo1112/cali-river-biomonitoring",
    slug: "cali-river",
    accent: "#aaf683",
  },
  {
    title: "Ortho Vision AI",
    tags: ["AI/ML", "Computer vision"],
    github: "https://github.com/saulo1112/Ortho-Vision-AI",
    slug: "ortho-vision",
    accent: "#ffb3c1",
  },
  {
    // TODO: real title, tags, github URL and lightbox content pending
    title: "[TODO: project name]",
    tags: ["TBD"],
    accent: "#0057A4",
  },
  {
    // TODO: real title, tags, github URL and lightbox content pending
    title: "[TODO: project name]",
    tags: ["TBD"],
    accent: "#D35400",
  },
];
---

<section class="projects" id="work">
  <div class="container">
    <header class="head">
      <h2 class="heading">Featured<br />Projects</h2>
      <a class="view-all" href="#work-grid">View all work ↗</a>
    </header>

    <div class="featured">
      {
        featured.map((p) => (
          <article class="item" style={`--accent: ${p.accent};`}>
            <div class="media">
              <video
                src={p.video}
                autoplay
                loop
                muted
                playsinline
                preload="none"
                style={`object-fit: ${p.fit ?? "cover"}; width: 100%; height: 100%; display: block; border-radius: 0;${p.zoom && p.zoom !== 1 ? ` transform: scale(${p.zoom}); transform-origin: center;` : ""}`}
              />
              <a
                class="gh"
                href={p.github}
                target="_blank"
                rel="noopener"
                aria-label={`GitHub: ${p.title}`}
              >
                GitHub ↗
              </a>
            </div>
            <div class="info">
              <div class="tags">
                {p.tags.slice(0, 2).map((t, i) => (
                  <span class={i === 0 ? "tag tag-accent" : "tag"}>{t}</span>
                ))}
              </div>
              <h3 class="title">{p.title}</h3>
              <p class="problem">{p.problem}</p>
              <p class="stack">{p.stack}</p>
              {p.slug && (
                <div class="links">
                  <span class="case">Overview →</span>
                </div>
              )}
            </div>
            {p.slug && (
              <button
                class="card-trigger"
                data-lb-open={p.slug}
                aria-label={`Open ${p.title} overview`}
              />
            )}
          </article>
        ))
      }
    </div>

    <h2 class="heading heading-sm" id="work-grid">Other<br />projects</h2>

    <div class="small">
      {
        small.map((p) => (
          <article class="item-sm" style={`--accent: ${p.accent};`}>
            <div class="media">
              {(() => {
                const thumb = thumbOf(p.slug);
                return thumb ? (
                  <Image
                    src={thumb}
                    alt={`${p.title} preview`}
                    widths={[360, 620, 1240]}
                    sizes="(max-width: 600px) 92vw, (max-width: 1360px) 45vw, 620px"
                    loading="lazy"
                    decoding="async"
                  />
                ) : null;
              })()}
              {p.github && (
                <a
                  class="gh"
                  href={p.github}
                  target="_blank"
                  rel="noopener"
                  aria-label={`GitHub: ${p.title}`}
                >
                  GitHub ↗
                </a>
              )}
            </div>
            <div class="info">
              <div class="tags">
                {p.tags.slice(0, 2).map((t, i) => (
                  <span class={i === 0 ? "tag tag-accent" : "tag"}>{t}</span>
                ))}
              </div>
              <h3 class="title">{p.title}</h3>
              {p.slug && <span class="case">Overview →</span>}
            </div>
            {p.slug && (
              <button
                class="card-trigger"
                data-lb-open={p.slug}
                aria-label={`Open ${p.title} overview`}
              />
            )}
          </article>
        ))
      }
    </div>
  </div>

  {
    Object.entries(projectDetails).map(([slug, detail]) => (
      <ProjectLightbox slug={slug} detail={detail} />
    ))
  }
</section>

<style>
  .projects {
    padding: 96px 0;
    border-top: 1px solid var(--color-border);
  }

  .container {
    max-width: 1360px;
    margin: 0 auto;
    padding-inline: 48px;
  }

  /* ---- Headings ---- */
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .heading {
    font-size: clamp(48px, 6vw, 80px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .heading-sm {
    font-size: clamp(32px, 4vw, 52px);
    margin-top: 72px;
    margin-bottom: 40px;
  }

  .view-all {
    align-self: flex-end;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    padding: 10px 20px;
    border-radius: 99px;
    font-size: 13px;
    color: var(--color-text-secondary);
    white-space: nowrap;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .view-all:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* ---- Featured — 2x2 grid of vertical cards ---- */
  .featured {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 48px;
  }

  .item {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    background: var(--color-surface);
    border: 1.5px solid color-mix(in srgb, var(--accent) 25%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 8%, transparent),
      0 20px 40px rgba(0, 0, 0, 0.3);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  /* Glow intensifies on hover — no transform, to keep overflow:hidden clipping intact */
  .item:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 20%, transparent),
      0 0 32px color-mix(in srgb, var(--accent) 15%, transparent),
      0 24px 48px rgba(0, 0, 0, 0.4);
  }

  /* ---- Media area (video on top) ---- */
  .media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: #000;
  }

  /* Cards without a screenshot yet (no <img> inside .media) fall back to a
     solid panel in the project's own accent — a placeholder that still reads
     as "this project" rather than a blank box. */
  .item-sm .media:not(:has(img)) {
    background: var(--accent);
  }

  /* Invisible full-card button — makes the whole card open the lightbox while
     leaving the GitHub pill (higher z-index) clickable on its own. */
  .card-trigger {
    position: absolute;
    inset: 0;
    z-index: 2;
    appearance: none;
    border: 0;
    padding: 0;
    background: none;
    cursor: pointer;
  }

  .card-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 20px;
  }

  /* GitHub pill — sits above the card trigger so it stays independently clickable */
  .gh {
    display: inline-block;
    position: absolute;
    bottom: 12px;
    right: 12px;
    z-index: 3;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 99px;
    padding: 6px 14px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .item:hover .gh {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  /* ---- Content panel (solid, below video) ---- */
  .info {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px;
    background: var(--color-surface);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    font-size: 11px;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: 99px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .tag-accent {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    color: var(--accent);
  }

  .info .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  .problem {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .stack {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .links {
    margin-top: 2px;
  }

  .case {
    font-size: 13px;
    font-weight: 500;
    /* Matches each card's own --accent (set inline per project) rather than
       the global theme accent, so the link color follows the card's tint. */
    color: var(--accent);
    transition: opacity 0.2s ease;
  }

  .case:hover {
    opacity: 0.75;
  }

  /* ---- Secondary — same card shape as Featured, with a screenshot preview ---- */
  .small {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .item-sm {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    background: var(--color-surface);
    border: 1.5px solid color-mix(in srgb, var(--accent) 25%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 8%, transparent),
      0 20px 40px rgba(0, 0, 0, 0.3);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .item-sm:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 20%, transparent),
      0 0 32px color-mix(in srgb, var(--accent) 15%, transparent),
      0 24px 48px rgba(0, 0, 0, 0.4);
  }

  /* Card preview. Portrait screenshots lose most of their height to the 16/11
     crop, so they are anchored to the top where the app header still reads. */
  .item-sm .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .item-sm .info {
    gap: 10px;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .small {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .container {
      padding-inline: 24px;
    }
  }

  @media (max-width: 600px) {
    .small {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Project lightbox — native <dialog> gives focus trapping and Esc-to-close;
  // we add open/close wiring, backdrop dismissal and scroll locking.
  const openers = document.querySelectorAll<HTMLButtonElement>("[data-lb-open]");

  const lockScroll = (locked: boolean) => {
    document.body.style.overflow = locked ? "hidden" : "";
  };

  for (const btn of openers) {
    btn.addEventListener("click", () => {
      const slug = btn.dataset.lbOpen;
      const dialog = document.getElementById(
        `lb-${slug}`,
      ) as HTMLDialogElement | null;
      if (!dialog) return;
      dialog.showModal();
      lockScroll(true);
      // Start at the top even if this dialog was scrolled on a previous open.
      dialog.querySelector(".lb-body")?.scrollTo(0, 0);
    });
  }

  for (const dialog of document.querySelectorAll<HTMLDialogElement>("dialog.lb")) {
    dialog.addEventListener("close", () => lockScroll(false));

    dialog
      .querySelector<HTMLButtonElement>("[data-lb-close]")
      ?.addEventListener("click", () => dialog.close());

    // Click outside the panel closes it. The dialog element itself fills the
    // backdrop area, so a click landing on it (not on .lb-body) means outside.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
