---
const featured = [
  {
    title: "EUDR Forest Risk Assessment",
    subtitle: "Geospatial ML · FastAPI · PostGIS",
    github: "https://github.com/saulo1112/EUDR_Risk_Assessment",
    placeholder: "[screenshot: EUDR dashboard]",
    cardClass: "c-eudr",
  },
  {
    title: "Retail Site Selection Engine",
    subtitle: "Spatial ML · H3 · FastAPI · Streamlit",
    github: "https://github.com/saulo1112/Site_selection_engine",
    placeholder: "[screenshot: H3 map]",
    cardClass: "c-site",
  },
];

const small = [
  {
    title: "RioCauca Baseline",
    subtitle: "GIS · Python",
    github: "https://github.com/saulo1112",
    placeholder: "[screenshot: RioCauca]",
    cardClass: "c-rio",
  },
  {
    title: "Cali River Biomonitoring",
    subtitle: "GIS · Research",
    github: "https://github.com/saulo1112",
    placeholder: "[screenshot: biomonitoring]",
    cardClass: "c-cali",
  },
  {
    title: "Fudambient",
    subtitle: "Web · Client work",
    github: "https://github.com/saulo1112",
    placeholder: "[screenshot: Fudambient]",
    cardClass: "c-fud",
  },
  {
    title: "OptiCoder",
    subtitle: "Mobile · React Native",
    github: "https://github.com/saulo1112",
    placeholder: "[screenshot: OptiCoder]",
    cardClass: "c-opti",
  },
];
---

<section class="projects" id="work">
  <div class="container">
    <header class="head">
      <h2 class="heading">Featured<br />Projects</h2>
      <a class="view-all" href="#work-grid">View all work ↗</a>
    </header>

    <div class="featured grid-2">
      {
        featured.map((p) => (
          <article class="item">
            <div class={`shot ${p.cardClass}`}>
              <div class="ph">
                <span>{p.placeholder}</span>
              </div>
              <a
                class="gh"
                href={p.github}
                target="_blank"
                rel="noopener"
                aria-label={`GitHub: ${p.title}`}
              >
                GitHub ↗
              </a>
            </div>
            <h3 class="title">{p.title}</h3>
            <p class="subtitle">{p.subtitle}</p>
          </article>
        ))
      }
    </div>

    <h2 class="heading heading-sm" id="work-grid">Other<br />projects</h2>

    <div class="small grid-2">
      {
        small.map((p) => (
          <article class="item item-sm">
            <div class={`shot ${p.cardClass}`}>
              <div class="ph">
                <span>{p.placeholder}</span>
              </div>
              <a
                class="gh"
                href={p.github}
                target="_blank"
                rel="noopener"
                aria-label={`GitHub: ${p.title}`}
              >
                GitHub ↗
              </a>
            </div>
            <h3 class="title">{p.title}</h3>
            <p class="subtitle">{p.subtitle}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects {
    padding: 96px 0;
    border-top: 1px solid var(--color-border);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: 48px;
  }

  /* ---- Headings ---- */
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .heading {
    font-size: clamp(48px, 6vw, 80px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .heading-sm {
    font-size: clamp(32px, 4vw, 52px);
    margin-top: 72px;
    margin-bottom: 40px;
  }

  .view-all {
    align-self: flex-end;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    padding: 10px 20px;
    border-radius: 99px;
    font-size: 13px;
    color: var(--color-text-secondary);
    white-space: nowrap;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .view-all:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* ---- Grids ---- */
  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .featured {
    gap: 28px;
    margin-top: 48px;
  }

  .small {
    gap: 24px;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ---- Image card ---- */
  .shot {
    position: relative;
    width: 100%;
    height: 380px;
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .shot:hover {
    transform: scale(1.02);
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.5);
  }

  .item-sm .shot {
    height: 240px;
    border-radius: 12px;
  }

  /* Card gradients */
  .c-eudr {
    background: linear-gradient(145deg, #0d2818 0%, #0a1f12 60%, #061509 100%);
  }
  .c-site {
    background: linear-gradient(145deg, #0d1520 0%, #091018 60%, #050a12 100%);
  }
  .c-rio {
    background: linear-gradient(145deg, #1a1008 0%, #120b05 100%);
  }
  .c-cali {
    background: linear-gradient(145deg, #080d1a 0%, #05091200 100%);
  }
  .c-fud {
    background: linear-gradient(145deg, #0f0f18 0%, #0a0a12 100%);
  }
  .c-opti {
    background: linear-gradient(145deg, #0f1a12 0%, #091209 100%);
  }

  /* Placeholder — centered dashed box */
  .ph {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 80%;
    height: 70%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed rgba(255, 255, 255, 0.08);
    border-radius: 8px;
  }

  .ph span {
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(255, 255, 255, 0.2);
  }

  /* When a real screenshot is added later */
  .shot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* GitHub pill */
  .gh {
    display: inline-block;
    position: absolute;
    bottom: 16px;
    right: 16px;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 99px;
    padding: 6px 14px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .shot:hover .gh {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  /* ---- Title + subtitle (below card) ---- */
  .title {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  .subtitle {
    margin: 0;
    font-size: 14px;
    color: var(--color-text-muted);
  }

  .item-sm .title {
    font-size: 16px;
  }

  .item-sm .subtitle {
    font-size: 13px;
  }

  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .container {
      padding-inline: 24px;
    }
    .grid-2 {
      grid-template-columns: 1fr;
    }
    .shot {
      height: 280px;
    }
    .item-sm .shot {
      height: 180px;
    }
  }
</style>
