---
import eudrVideo from "../Assets/Videos/EUDR Hero Animation.mp4";
import fudambientVideo from "../Assets/Videos/Fudambient.mp4";
import physicalRecoveryVideo from "../Assets/Videos/App Physical Recovery.mp4";
import optiCoderVideo from "../Assets/Videos/OptiCoder Hero.mp4";

const featured = [
  {
    title: "EUDR Forest Risk Assessment",
    tags: ["GIS", "Machine learning", "FastAPI"],
    problem:
      "How do you screen 4,170 real agricultural parcels for EU deforestation compliance — using only open satellite data?",
    stack: "Python · PostGIS · Earth Engine · scikit-learn · Docker",
    github: "https://github.com/saulo1112/EUDR_Risk_Assessment",
    caseStudy: "/projects/eudr-risk-assessment",
    video: eudrVideo,
    accent: "#1D9E75",
  },
  {
    title: "Fudambient",
    tags: ["Web", "Client work"],
    problem:
      "Designing and building the institutional website for an environmental NGO — from information architecture to launch.",
    stack: "HTML · CSS · JavaScript",
    github: "https://github.com/saulo1112/Fudambient-Page",
    caseStudy: null,
    video: fudambientVideo,
    accent: "#3B82F6",
  },
  {
    title: "App Physical Recovery",
    tags: ["AI/ML", "Computer vision", "Deep learning"],
    problem:
      "Can two deep learning models — person detection and pose estimation — turn a phone camera into a physiotherapy coach?",
    stack: "PyTorch · HuggingFace · gRPC · Streamlit · Docker",
    // TODO: update with saulo1112 fork URL
    github: "#",
    caseStudy: null,
    video: physicalRecoveryVideo,
    accent: "#8B5CF6",
  },
  {
    title: "OptiCoder",
    tags: ["Mobile", "React Native"],
    problem: "TODO: one-line problem statement — what does this app solve?",
    stack: "React Native · TypeScript · Expo",
    github: "https://github.com/saulo1112/PDproject",
    caseStudy: null,
    video: optiCoderVideo,
    accent: "#F59E0B",
  },
];

const small = [
  {
    title: "Site Selection Engine",
    tags: ["GIS", "Spatial ML"],
    github: "https://github.com/saulo1112/Site_selection_engine",
  },
  {
    title: "RioCauca Baseline",
    tags: ["GIS", "Python"],
    github: "https://github.com/saulo1112/RioCauca_Baseline",
  },
  {
    title: "Cali River Biomonitoring",
    tags: ["GIS", "Research"],
    github: "https://github.com/saulo1112/cali-river-biomonitoring",
  },
  {
    title: "[TODO: biomedical prosthetics detection project]",
    tags: ["AI/ML", "Computer vision"],
    // TODO: add repo URL
    github: "#",
  },
];
---

<section class="projects" id="work">
  <div class="container">
    <header class="head">
      <h2 class="heading">Featured<br />Projects</h2>
      <a class="view-all" href="#work-grid">View all work ↗</a>
    </header>

    <div class="featured">
      {
        featured.map((p) => (
          <article class="item" style={`--accent: ${p.accent};`}>
            <div class="media">
              <video
                src={p.video}
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
                style="object-fit: cover; width: 100%; height: 100%; display: block; border-radius: 0;"
              />
              <a
                class="gh"
                href={p.github}
                target="_blank"
                rel="noopener"
                aria-label={`GitHub: ${p.title}`}
              >
                GitHub ↗
              </a>
            </div>
            <div class="info">
              <div class="tags">
                {p.tags.slice(0, 2).map((t, i) => (
                  <span class={i === 0 ? "tag tag-accent" : "tag"}>{t}</span>
                ))}
              </div>
              <h3 class="title">{p.title}</h3>
              <p class="problem">{p.problem}</p>
              <p class="stack">{p.stack}</p>
              {p.caseStudy && (
                <div class="links">
                  <a class="case" href={p.caseStudy}>
                    Case study →
                  </a>
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <h2 class="heading heading-sm" id="work-grid">Other<br />projects</h2>

    <div class="small">
      {
        small.map((p) => (
          <article class="item-sm">
            <div class="tags">
              {p.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
            <h3 class="title-sm">{p.title}</h3>
            <a
              class="gh-link"
              href={p.github}
              target="_blank"
              rel="noopener"
              aria-label={`GitHub: ${p.title}`}
            >
              GitHub ↗
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .projects {
    padding: 96px 0;
    border-top: 1px solid var(--color-border);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: 48px;
  }

  /* ---- Headings ---- */
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .heading {
    font-size: clamp(48px, 6vw, 80px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .heading-sm {
    font-size: clamp(32px, 4vw, 52px);
    margin-top: 72px;
    margin-bottom: 40px;
  }

  .view-all {
    align-self: flex-end;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    padding: 10px 20px;
    border-radius: 99px;
    font-size: 13px;
    color: var(--color-text-secondary);
    white-space: nowrap;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .view-all:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* ---- Featured — 2x2 grid of vertical cards ---- */
  .featured {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 48px;
  }

  .item {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    background: var(--color-surface);
    border: 1.5px solid color-mix(in srgb, var(--accent) 25%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 8%, transparent),
      0 20px 40px rgba(0, 0, 0, 0.3);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  /* Glow intensifies on hover — no transform, to keep overflow:hidden clipping intact */
  .item:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--accent) 20%, transparent),
      0 0 32px color-mix(in srgb, var(--accent) 15%, transparent),
      0 24px 48px rgba(0, 0, 0, 0.4);
  }

  /* ---- Media area (video on top) ---- */
  .media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  /* GitHub pill — only thing allowed on top of the video */
  .gh {
    display: inline-block;
    position: absolute;
    bottom: 12px;
    right: 12px;
    z-index: 2;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 99px;
    padding: 6px 14px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .item:hover .gh {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  /* ---- Content panel (solid, below video) ---- */
  .info {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    background: var(--color-surface);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    font-size: 11px;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: 99px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .tag-accent {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    color: var(--accent);
  }

  .info .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  .problem {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .stack {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .links {
    margin-top: 2px;
  }

  .case {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-accent);
    transition: opacity 0.2s ease;
  }

  .case:hover {
    opacity: 0.75;
  }

  /* ---- Secondary — text-only cards ---- */
  .small {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .item-sm {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 20px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .item-sm:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
  }

  .item-sm .tag {
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }

  .title-sm {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .gh-link {
    font-size: 12px;
    color: var(--color-accent);
    transition: opacity 0.2s ease;
  }

  .gh-link:hover {
    opacity: 0.75;
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .small {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .container {
      padding-inline: 24px;
    }
  }

  @media (max-width: 600px) {
    .small {
      grid-template-columns: 1fr;
    }
  }
</style>
