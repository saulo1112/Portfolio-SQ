<section class="hero" id="top">
  <canvas class="bg" id="hero-canvas" aria-hidden="true"></canvas>

  <div class="inner">
    <div class="copy">
      <p class="eyebrow">Software Engineer · GIS Specialist</p>

      <h1>
        Backend, <span class="accent">spatial</span> data<br />and applied AI.
      </h1>

      <p class="subtext">
        I build APIs, geospatial pipelines and systems that process real data.
        FastAPI, PostGIS, Python and Node.js in production.
      </p>

      <div class="cta">
        <a class="btn btn-primary" href="#work">View projects</a>
        <a
          class="btn btn-secondary"
          href="/cv.pdf"
          target="_blank"
          rel="noopener"
        >
          Download CV
        </a>
      </div>
    </div>

    <div class="visual">
      <div class="spline-container">
        <iframe
          src="https://my.spline.design/genkubgreetingrobot-LUC3wryx729Jtr0t1DjLZdFm/"
          frameborder="0"
          width="100%"
          height="100%"
          loading="lazy"
          title="3D Robot"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* overflow: clip instead of hidden — prevents scroll without creating a
       stacking context that clips Spline's shadow-DOM iframe rendering. */
    overflow: clip;
    min-height: calc(100svh - 60px);
    display: flex;
    align-items: center;
  }

  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
  }

  .inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 64px 24px;
    display: grid;
    grid-template-columns: 55% 45%;
    align-items: center;
    gap: 32px;
  }

  /* ---- Left column ---- */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 20px;
  }

  h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  h1 .accent {
    color: var(--color-accent);
  }

  .subtext {
    margin-top: 20px;
    max-width: 480px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .cta {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    font-size: 13px;
    font-weight: 500;
    padding: 10px 20px;
    border-radius: var(--radius-control);
    border: 1px solid transparent;
    transition: background-color 0.15s ease, border-color 0.15s ease,
      color 0.15s ease;
  }

  .btn-primary {
    background-color: var(--color-accent);
    color: var(--color-bg);
  }

  .btn-primary:hover {
    background-color: var(--color-accent-hover);
  }

  .btn-secondary {
    background-color: transparent;
    border-color: var(--color-border);
    color: var(--color-text-secondary);
  }

  .btn-secondary:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-muted);
  }

  /* ---- Right column ---- */
  .visual {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .spline-container {
    width: 100%;
    height: 500px;
    position: relative;
    z-index: 1;
    background: transparent;
    mix-blend-mode: lighten;
  }

  .spline-container iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: none;
  }

  @media (max-width: 768px) {
    .inner {
      grid-template-columns: 1fr;
      padding: 48px 24px;
      gap: 0;
    }
    .visual {
      display: none;
    }
    .spline-container {
      display: none;
    }
  }
</style>

<script>
  const COLOR = "#ffffff";
  const COUNT = 120;
  const CONNECT_DIST = 130;
  const DESTROY_RADIUS = 90;   // soft push zone outer edge
  const KILL_RADIUS = 50;      // particles closer than this get destroyed
  const MOUSE_LINE_DIST = 100;

  const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement | null;
  const ctx = canvas?.getContext("2d") ?? null;

  if (canvas && ctx) {
    let w = 0;
    let h = 0;
    let dpr = 1;
    let mouse: { x: number; y: number } | null = null;

    type Particle = {
      x: number;
      y: number;
      vx: number;
      vy: number;
      r: number;
      baseOpacity: number;  // target opacity when alive
      opacity: number;      // current rendered opacity
      dead: boolean;        // true while destroyed / waiting to respawn
      respawnAt: number;    // performance.now() timestamp to respawn
    };

    const rand = (min: number, max: number) => min + Math.random() * (max - min);

    let particles: Particle[] = [];

    const makeParticle = (): Particle => {
      const base = rand(0.4, 0.8);
      return {
        x: rand(0, w),
        y: rand(0, h),
        vx: rand(-0.4, 0.4),
        vy: rand(-0.4, 0.4),
        r: rand(1.5, 3),
        baseOpacity: base,
        opacity: base,
        dead: false,
        respawnAt: 0,
      };
    };

    // Spawn a particle just off a random canvas edge so it fades in as it enters.
    const respawnParticle = (p: Particle) => {
      const side = Math.floor(Math.random() * 4);
      if (side === 0) { p.x = rand(0, w); p.y = -10; }       // top
      else if (side === 1) { p.x = w + 10; p.y = rand(0, h); } // right
      else if (side === 2) { p.x = rand(0, w); p.y = h + 10; } // bottom
      else { p.x = -10; p.y = rand(0, h); }                    // left
      p.vx = rand(-0.4, 0.4);
      p.vy = rand(-0.4, 0.4);
      p.dead = false;
      p.opacity = 0; // fade in from invisible
    };

    const init = () => {
      particles = Array.from({ length: COUNT }, makeParticle);
    };

    const resize = () => {
      dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      const newW = rect.width;
      const newH = rect.height;
      if (w > 0 && h > 0 && particles.length > 0) {
        for (const p of particles) {
          p.x = (p.x / w) * newW;
          p.y = (p.y / h) * newH;
        }
      }
      w = newW;
      h = newH;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const frame = () => {
      ctx.clearRect(0, 0, w, h);
      const now = performance.now();

      // ---- Per-particle update ----
      for (const p of particles) {

        // Handle respawn timing for dead particles.
        if (p.dead) {
          if (now >= p.respawnAt) {
            respawnParticle(p);
          } else {
            // Still dead: fly outward and fade out.
            p.x += p.vx;
            p.y += p.vy;
            p.opacity = Math.max(0, p.opacity - 0.04);
            continue; // skip the live-particle logic below
          }
        }

        // Live particle: fade in if still recovering from respawn.
        if (p.opacity < p.baseOpacity) {
          p.opacity = Math.min(p.baseOpacity, p.opacity + 0.02);
        }

        // Mouse interaction.
        if (mouse) {
          const dx = p.x - mouse.x;
          const dy = p.y - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < KILL_RADIUS && dist > 0) {
            // Destruction: burst away and mark dead.
            const angle = Math.atan2(dy, dx);
            p.vx += Math.cos(angle) * 8;
            p.vy += Math.sin(angle) * 8;
            p.dead = true;
            p.respawnAt = now + rand(1000, 2000);
          } else if (dist < DESTROY_RADIUS && dist > 0) {
            // Soft shield edge: gentle outward nudge.
            const angle = Math.atan2(dy, dx);
            const force = (DESTROY_RADIUS - dist) * 0.025;
            p.x += Math.cos(angle) * force;
            p.y += Math.sin(angle) * force;
          }
        }

        // Move and bounce off edges.
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > w) { p.vx = -p.vx; p.x = Math.max(0, Math.min(w, p.x)); }
        if (p.y < 0 || p.y > h) { p.vy = -p.vy; p.y = Math.max(0, Math.min(h, p.y)); }
      }

      // ---- Draw connections between live particles ----
      for (let i = 0; i < particles.length; i++) {
        if (particles[i].dead && particles[i].opacity <= 0) continue;
        for (let j = i + 1; j < particles.length; j++) {
          if (particles[j].dead && particles[j].opacity <= 0) continue;
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < CONNECT_DIST) {
            const lineAlpha =
              (1 - dist / CONNECT_DIST) *
              0.25 *
              Math.min(particles[i].opacity / particles[i].baseOpacity, particles[j].opacity / particles[j].baseOpacity);
            if (lineAlpha <= 0) continue;
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = COLOR;
            ctx.globalAlpha = lineAlpha;
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }
      }

      // ---- Draw mouse-to-particle lines (live particles only) ----
      if (mouse) {
        for (const p of particles) {
          if (p.dead) continue;
          const dx = p.x - mouse.x;
          const dy = p.y - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < MOUSE_LINE_DIST) {
            ctx.beginPath();
            ctx.moveTo(mouse.x, mouse.y);
            ctx.lineTo(p.x, p.y);
            ctx.strokeStyle = COLOR;
            ctx.globalAlpha = (1 - dist / MOUSE_LINE_DIST) * 0.6 * (p.opacity / p.baseOpacity);
            ctx.lineWidth = 0.8;
            ctx.stroke();
          }
        }
      }

      // ---- Draw particles ----
      ctx.globalAlpha = 1;
      for (const p of particles) {
        if (p.opacity <= 0) continue;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = COLOR;
        ctx.globalAlpha = p.opacity;
        ctx.fill();
      }

      ctx.globalAlpha = 1;
      requestAnimationFrame(frame);
    };

    canvas.addEventListener("mousemove", (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse = { x: e.clientX - rect.left, y: e.clientY - rect.top };
    });
    canvas.addEventListener("mouseleave", () => { mouse = null; });

    window.addEventListener("resize", resize);

    resize();
    init();
    requestAnimationFrame(frame);
  }
</script>
