---
// Technology pyramid — six rows of chips, largest/most-central at the top
// tapering to small supporting tools at the bottom. Importance is encoded by
// size + vertical position, not by labels.
//
// Icons are LOCAL SVGs from src/assets/Images/Icons, imported as Vite assets
// (?url → resolved URL string, works for both <img src> and CSS mask-image).
// Two categories of color treatment:
//   • brand   — SVG has real brand colors → grayscale by default, color on hover
//   • mono    — SVG is solid black (Flask, GPT) → CSS mask recolors gray → teal
// Filenames are case-sensitive and used exactly as they exist on disk. There is
// no dedicated PostGIS icon, so PostGIS reuses the PostgreSQL SVG (PosgreSQL.svg).

import python from "../assets/Images/Icons/Python.svg?url";
import pytorch from "../assets/Images/Icons/Pytorch.svg?url";
import postgres from "../assets/Images/Icons/PosgreSQL.svg?url";
import fastapi from "../assets/Images/Icons/FastAPI.svg?url";
import numpy from "../assets/Images/Icons/NumPy.svg?url";
import pandas from "../assets/Images/Icons/Pandas.svg?url";
import scikitlearn from "../assets/Images/Icons/scikit-learn.svg?url";
import earthengine from "../assets/Images/Icons/google-earth-engine.svg?url";
import arcgis from "../assets/Images/Icons/arcgis.svg?url";
import docker from "../assets/Images/Icons/Docker.svg?url";
import react from "../assets/Images/Icons/React.svg?url";
import nodejs from "../assets/Images/Icons/Node.js.svg?url";
import flask from "../assets/Images/Icons/Flask.svg?url";
import opencv from "../assets/Images/Icons/OpenCV.svg?url";
import qgis from "../assets/Images/Icons/qgis.svg?url";
import javascript from "../assets/Images/Icons/JavaScript.svg?url";
import typescript from "../assets/Images/Icons/TypeScript.svg?url";
import mapbox from "../assets/Images/Icons/mapbox.svg?url";
import leaflet from "../assets/Images/Icons/leaflet.svg?url";
import maplibre from "../assets/Images/Icons/maplibre.svg?url";
import rlang from "../assets/Images/Icons/R.svg?url";
import html from "../assets/Images/Icons/HTML5.svg?url";
import css from "../assets/Images/Icons/CSS3.svg?url";
import reactnative from "../assets/Images/Icons/react-native.svg?url";
import astro from "../assets/Images/Icons/Astro.svg?url";
import git from "../assets/Images/Icons/Git.svg?url";
import github from "../assets/Images/Icons/GitHub.svg?url";
import gitlab from "../assets/Images/Icons/GitLab.svg?url";
import claude from "../assets/Images/Icons/claude.svg?url";
import gpt from "../assets/Images/Icons/openai-chatgpt.svg?url";
import gemini from "../assets/Images/Icons/gemini.svg?url";
import mysql from "../assets/Images/Icons/MySQL.svg?url";
import aws from "../assets/Images/Icons/AWS.svg?url";
import jupyter from "../assets/Images/Icons/Jupyter.svg?url";
import vscode from "../assets/Images/Icons/Visual Studio Code (VS Code).svg?url";
import figma from "../assets/Images/Icons/figma.svg?url";
import msoffice from "../assets/Images/Icons/microsoft-office.svg?url";

// rows[0] = top (largest). context only present on rows 1–3.
// mono: true  → solid-black source SVG, recolored via CSS mask (Flask, GPT,
// Mapbox, GitHub).
type Chip = { name: string; icon: string; context?: string; mono?: boolean };
const rows: Chip[][] = [
  // Row 1 — core stack
  [
    { name: "Python", icon: python, context: "Core language" },
    { name: "PyTorch", icon: pytorch, context: "Deep learning" },
    { name: "PostGIS", icon: postgres, context: "Spatial database" },
    { name: "FastAPI", icon: fastapi, context: "REST APIs" },
  ],
  // Row 2 — primary tools across domains
  [
    { name: "NumPy", icon: numpy, context: "Numerical computing" },
    { name: "Pandas", icon: pandas, context: "Data analysis" },
    { name: "scikit-learn", icon: scikitlearn, context: "ML modeling" },
    { name: "Google Earth Engine", icon: earthengine, context: "Satellite data" },
    { name: "ArcGIS Pro", icon: arcgis, context: "GIS desktop" },
    { name: "Docker", icon: docker, context: "Containers" },
  ],
  // Row 3 — supporting technical tools
  [
    { name: "React", icon: react, context: "Frontend" },
    { name: "Node.js", icon: nodejs, context: "Backend services" },
    { name: "Flask", icon: flask, mono: true, context: "Lightweight APIs" },
    { name: "OpenCV", icon: opencv, context: "Computer vision" },
    { name: "QGIS", icon: qgis, context: "GIS desktop" },
    { name: "PostgreSQL", icon: postgres, context: "Relational DB" },
    { name: "JavaScript", icon: javascript, context: "Web scripting" },
  ],
  // Row 4 — languages + mapping libraries
  [
    { name: "TypeScript", icon: typescript },
    { name: "Mapbox GL JS", icon: mapbox, mono: true }, // source SVG is single-color
    { name: "Leaflet", icon: leaflet },
    { name: "MapLibre GL", icon: maplibre },
    { name: "R", icon: rlang },
    { name: "HTML", icon: html },
    { name: "CSS", icon: css },
  ],
  // Row 5 — frontend extras, version control, AI tools
  [
    { name: "React Native", icon: reactnative },
    { name: "Astro", icon: astro },
    { name: "Git", icon: git },
    { name: "GitHub", icon: github, mono: true }, // source SVG is single-color
    { name: "GitLab", icon: gitlab },
    { name: "Claude", icon: claude },
    { name: "GPT", icon: gpt, mono: true },
    { name: "Gemini", icon: gemini },
  ],
  // Row 6 — general tooling (no hover lift)
  [
    { name: "MySQL", icon: mysql },
    { name: "AWS", icon: aws },
    { name: "Jupyter", icon: jupyter },
    { name: "VS Code", icon: vscode },
    { name: "Figma", icon: figma },
    { name: "MS Office", icon: msoffice },
  ],
];
---

<section id="stack" class="stack-section">
  <div class="inner">
    <p class="eyebrow">STACK</p>
    <h2 class="heading">Tools &amp; <span>technologies</span></h2>

    <div class="pyramid">
      {
        rows.map((row, i) => (
          <div class={`pyr-row row-${i + 1}`}>
            {row.map((chip) => (
              <span class="chip">
                <span class="icon">
                  {chip.mono ? (
                    // Solid-black source: mask + background-color so it reads as
                    // gray by default and teal on hover (see .icon-mono).
                    <span
                      class="icon-mono"
                      style={`-webkit-mask-image:url("${chip.icon}");mask-image:url("${chip.icon}")`}
                    />
                  ) : (
                    <img
                      class="chip-img"
                      src={chip.icon}
                      alt={chip.name}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </span>
                <span class="chip-text">
                  <span class="chip-name">{chip.name}</span>
                  {chip.context && <span class="chip-ctx">{chip.context}</span>}
                </span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* --s is the single scale knob: 1 on desktop, 0.85 on mobile. Every chip
     dimension that should shrink references it via calc(), so the ~15% mobile
     reduction is one declaration rather than per-row overrides. */
  .stack-section {
    --s: 1;
    padding: 96px 0;
    border-top: 1px solid var(--color-border);
  }

  .inner {
    /* Wider than the site-wide 1200px so chips spread further before wrapping.
       Scoped to this section only. */
    max-width: 1400px;
    margin: 0 auto;
    padding-inline: 48px;
  }

  /* Section header — matches the Services / Experience convention. */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 12px;
  }

  .heading {
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-text-primary);
    /* +24px breathing room between heading and the pyramid. */
    margin-bottom: 72px;
  }

  .heading span {
    color: var(--color-accent);
    filter: brightness(1.3);
  }

  /* ---- Pyramid ---- */
  .pyramid {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pyr-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    width: 100%;
    gap: var(--row-gap);
    margin-bottom: var(--row-mb);
  }

  /* Per-row base sizing. Scalable values (icon / padding / fonts / inner gap)
     are read through calc(* var(--s)); radius, row gap and row margin are fixed. */
  .row-1 { --icon: 36px; --pad-y: 18px; --pad-x: 26px; --name-fs: 16px; --name-w: 600; --ctx-fs: 11px; --chip-gap: 11px; --radius: 12px; --row-gap: 20px; --row-mb: 48px; }
  .row-2 { --icon: 30px; --pad-y: 15px; --pad-x: 22px; --name-fs: 14px; --name-w: 500; --ctx-fs: 11px; --chip-gap: 10px; --radius: 11px; --row-gap: 17px; --row-mb: 38px; }
  .row-3 { --icon: 27px; --pad-y: 13px; --pad-x: 20px; --name-fs: 13px; --name-w: 500; --ctx-fs: 10px; --chip-gap: 9px;  --radius: 10px; --row-gap: 14px; --row-mb: 34px; }
  .row-4 { --icon: 22px; --pad-y: 11px; --pad-x: 17px; --name-fs: 12px; --name-w: 500; --chip-gap: 8px;  --radius: 9px;  --row-gap: 12px; --row-mb: 26px; }
  .row-5 { --icon: 20px; --pad-y: 9px;  --pad-x: 15px; --name-fs: 12px; --name-w: 400; --chip-gap: 7px;  --radius: 7px;  --row-gap: 10px; --row-mb: 20px; }
  .row-6 { --icon: 17px; --pad-y: 7px;  --pad-x: 13px; --name-fs: 11px; --name-w: 400; --chip-gap: 6px;  --radius: 6px;  --row-gap: 8px;  --row-mb: 0; }

  /* ---- Chip — liquid glass, matching Services.astro cards ---- */
  .chip {
    /* Dark (default) premium white glass. */
    --g-bg: rgba(255, 255, 255, 0.03);
    --g-bg-hover: rgba(255, 255, 255, 0.05);
    --g-border: rgba(255, 255, 255, 0.08);
    --g-inner: rgba(255, 255, 255, 0.05);

    position: relative;
    /* Contain every child/pseudo effect (::after refraction line, backdrop
       halo, icon) to the chip's own rectangle so nothing bleeds onto neighbors,
       and give each chip its own stacking context. */
    overflow: hidden;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: calc(var(--chip-gap) * var(--s));
    padding: calc(var(--pad-y) * var(--s)) calc(var(--pad-x) * var(--s));
    border-radius: var(--radius);
    border: 1px solid var(--g-border);
    background: var(--g-bg);
    backdrop-filter: blur(7px) saturate(180%);
    -webkit-backdrop-filter: blur(7px) saturate(180%);
    transition: all 0.25s ease;
  }

  /* Light-theme fallback — swap white translucency for dark. */
  :global(html:not(.dark)) .chip {
    --g-bg: rgba(15, 15, 15, 0.04);
    --g-bg-hover: rgba(15, 15, 15, 0.06);
    --g-border: rgba(15, 15, 15, 0.1);
    --g-inner: rgba(15, 15, 15, 0.04);
  }

  /* Luminous inner border. */
  .chip::before {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: calc(var(--radius) - 1px);
    border: 1px solid var(--g-inner);
    pointer-events: none;
  }

  /* Top-edge light refraction line. */
  .chip::after {
    content: "";
    position: absolute;
    top: 0;
    left: 10%;
    width: 80%;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.25) 40%,
      color-mix(in srgb, var(--color-accent) 40%, transparent) 50%,
      rgba(255, 255, 255, 0.25) 60%,
      transparent
    );
  }

  /* Keep the icon + text above the pseudo-element layers. */
  .icon,
  .chip-text {
    position: relative;
    z-index: 1;
  }

  /* ---- Icon box — fixed square; the image/mask fills it absolutely.
     .icon is position:relative via the shared rule above. ---- */
  .icon {
    flex-shrink: 0;
    display: block;
    width: calc(var(--icon) * var(--s));
    height: calc(var(--icon) * var(--s));
  }

  /* Category A — brand-colored SVGs: gray by default, full color on hover. */
  .chip-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    filter: grayscale(1) brightness(1.4);
    transition: filter 0.3s ease;
  }

  .chip:hover .chip-img {
    filter: grayscale(0) brightness(1);
  }

  /* Category B — solid-black SVGs recolored via mask: mid-gray → accent teal.
     mask-image (the icon URL) is set inline per chip. */
  .icon-mono {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    background-color: rgba(255, 255, 255, 0.5);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
    transition: background-color 0.3s ease;
  }

  .chip:hover .icon-mono {
    background-color: var(--color-accent);
  }

  /* Light theme: a 50%-white fill would vanish on a light chip, so darken it. */
  :global(html:not(.dark)) .icon-mono {
    background-color: rgba(15, 15, 15, 0.45);
  }

  /* ---- Text block ---- */
  .chip-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    line-height: 1.2;
  }

  .chip-name {
    font-size: calc(var(--name-fs) * var(--s));
    font-weight: var(--name-w);
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .chip-ctx {
    font-size: calc(var(--ctx-fs) * var(--s));
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* Lift / glass-brighten only on rows 1–5; row 6 stays understated.
     The teal accent glow is INSET (contained by the chip → zero bleed onto
     neighbors); the only outset shadow is a neutral depth shadow, which is
     invisible against the dark background. */
  .pyr-row:not(.row-6) .chip:hover {
    background: var(--g-bg-hover);
    border-color: rgba(29, 158, 117, 0.3);
    transform: translateY(-3px);
    box-shadow:
      0 8px 20px rgba(0, 0, 0, 0.28),
      inset 0 0 16px rgba(29, 158, 117, 0.18);
  }

  /* ---- Mobile: shrink every scaled dimension ~15% in one line ---- */
  @media (max-width: 768px) {
    .stack-section {
      --s: 0.85;
      padding: 64px 0;
    }
    .inner {
      padding-inline: 24px;
    }
  }
</style>
