---
const columns = [
  {
    heading: "Geospatial",
    items: [
      { name: "PostGIS", desc: "spatial indexing and queries in production pipelines" },
      { name: "GDAL / Shapely", desc: "vector processing and coordinate transforms" },
      { name: "Google Earth Engine", desc: "satellite imagery acquisition at scale" },
      { name: "H3 (Uber)", desc: "hexagonal spatial indexing for ML features" },
      { name: "Leaflet / pydeck", desc: "interactive map rendering" },
    ],
  },
  {
    heading: "Backend & data",
    items: [
      { name: "FastAPI", desc: "REST APIs with Pydantic validation" },
      { name: "Python", desc: "primary language: data pipelines, ML, scripting" },
      { name: "PostgreSQL", desc: "relational storage with spatial extensions" },
      { name: "Docker", desc: "containerized reproducible environments" },
      { name: "scikit-learn", desc: "ML modeling with honest cross-validation" },
    ],
  },
  {
    heading: "Frontend & tooling",
    items: [
      { name: "JavaScript / TypeScript", desc: "frontend logic and Node.js APIs" },
      { name: "Node.js / Express", desc: "lightweight backend services" },
      { name: "Astro", desc: "static site generation (this site)" },
      { name: "Git", desc: "version control, conventional commits" },
    ],
  },
];
---

<section class="stack" id="stack">
  <div class="inner">
    <h2>Stack</h2>

    <div class="columns">
      {
        columns.map((col) => (
          <div class="column">
            <h3 class="col-heading">{col.heading}</h3>
            <ul>
              {col.items.map((item) => (
                <li class="row">
                  <span class="name">{item.name}</span>
                  <span class="desc">{item.desc}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stack {
    padding: 96px 24px;
  }

  .inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  h2 {
    margin-bottom: 40px;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .col-heading {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 8px;
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 0;
    border-top: 1px solid var(--color-border);
  }

  .name {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .desc {
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .stack {
      padding: 64px 24px;
    }
    .columns {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
