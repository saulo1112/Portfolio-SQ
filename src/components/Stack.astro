---
// Technology pyramid — six rows of chips, largest/most-central at the top
// tapering to small supporting tools at the bottom. Importance is encoded by
// size + vertical position, not by labels. Icons load from the Simple Icons CDN
// with a graceful inline-SVG fallback so a broken image is never shown.

// cdn.simpleicons.org serves each icon in its real BRAND color (verified
// image/svg+xml) — so the CSS grayscale filter can fade gray → full color on
// hover. (The npm/jsdelivr path serves monochrome-black SVGs, which were
// invisible on the dark glass chips.) URL form: cdn.simpleicons.org/{slug}.
const CDN = "https://cdn.simpleicons.org/";

// Hand-drawn fallbacks (16×16, currentColor stroke) for icons that 404 on the
// endpoint, plus a neutral generic as the universal onerror safety net.
const fallbacks = {
  generic:
    '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="3" width="11" height="10" rx="2"/><path d="M2.5 11l3-2.5 2.2 1.8L11 8l2.5 2"/><circle cx="6" cy="6" r="1"/></svg>',
  sparkle:
    '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M8 1.5l1.4 5.1 5.1 1.4-5.1 1.4L8 14.5l-1.4-5.1L1.5 8l5.1-1.4z"/></svg>',
  cloud:
    '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5h6.2a2.7 2.7 0 0 0 .2-5.4A3.5 3.5 0 0 0 4.7 6 2.9 2.9 0 0 0 5 12.5z"/></svg>',
  code:
    '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4.5L2 8l4 3.5M10 4.5L14 8l-4 3.5"/></svg>',
  doc:
    '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2h5l3 3v9H4z"/><path d="M9 2v3h3M6 8.5h4M6 11h4"/></svg>',
};

// rows[0] = top (largest). context only present on rows 1–3.
const rows = [
  // Row 1 — core stack
  [
    { name: "Python", slug: "python", context: "Core language" },
    { name: "PyTorch", slug: "pytorch", context: "Deep learning" },
    { name: "PostGIS", slug: "postgresql", context: "Spatial database" },
    { name: "FastAPI", slug: "fastapi", context: "REST APIs" },
  ],
  // Row 2 — primary tools across domains
  [
    { name: "NumPy", slug: "numpy", context: "Numerical computing" },
    { name: "Pandas", slug: "pandas", context: "Data analysis" },
    { name: "scikit-learn", slug: "scikitlearn", context: "ML modeling" },
    { name: "Google Earth Engine", slug: "googleearthengine", context: "Satellite data" },
    { name: "ArcGIS Pro", slug: "arcgis", context: "GIS desktop" },
    { name: "Docker", slug: "docker", context: "Containers" },
  ],
  // Row 3 — supporting technical tools
  [
    { name: "React", slug: "react", context: "Frontend" },
    { name: "Node.js", slug: "nodedotjs", context: "Backend services" },
    { name: "Flask", slug: "flask", context: "Lightweight APIs" },
    { name: "OpenCV", slug: "opencv", context: "Computer vision" },
    { name: "QGIS", slug: "qgis", context: "GIS desktop" },
    { name: "PostgreSQL", slug: "postgresql", context: "Relational DB" },
    { name: "JavaScript", slug: "javascript", context: "Web scripting" },
  ],
  // Row 4 — languages + mapping libraries
  [
    { name: "TypeScript", slug: "typescript" },
    { name: "Mapbox GL JS", slug: "mapbox" },
    { name: "Leaflet", slug: "leaflet" },
    { name: "MapLibre GL", slug: "maplibre" },
    { name: "R", slug: "r" },
    { name: "HTML", slug: "html5" },
    { name: "CSS", slug: "css" },
  ],
  // Row 5 — frontend extras, version control, AI tools
  [
    { name: "React Native", slug: "react" },
    { name: "Astro", slug: "astro" },
    { name: "Git", slug: "git" },
    { name: "GitHub", slug: "github" },
    { name: "GitLab", slug: "gitlab" },
    { name: "Claude", slug: "claude" },
    { name: "GPT", fb: "sparkle" }, // openai icon removed from simple-icons (trademark)
    { name: "Gemini", slug: "googlegemini" },
  ],
  // Row 6 — general tooling (no hover lift)
  [
    { name: "MySQL", slug: "mysql" },
    { name: "AWS", fb: "cloud" }, // amazonaws icon removed from simple-icons (trademark)
    { name: "Jupyter", slug: "jupyter" },
    { name: "VS Code", fb: "code" }, // visualstudiocode icon removed from simple-icons (trademark)
    { name: "Figma", slug: "figma" },
    { name: "MS Office", fb: "doc" }, // microsoftoffice icon removed from simple-icons (trademark)
  ],
];
---

<section id="stack" class="stack-section">
  <div class="inner">
    <p class="eyebrow">STACK</p>
    <h2 class="heading">Tools &amp; <span>technologies</span></h2>

    <div class="pyramid">
      {
        rows.map((row, i) => (
          <div class={`pyr-row row-${i + 1}`}>
            {row.map((chip) => (
              <span class="chip">
                <span class="icon">
                  {chip.slug && (
                    <img
                      class="chip-img"
                      src={`${CDN}${chip.slug}`}
                      alt={chip.name}
                      loading="lazy"
                      decoding="async"
                      onerror="this.style.display='none';this.nextElementSibling.hidden=false;"
                    />
                  )}
                  {/* Hidden behind the brand img; revealed on error. When there
                      is no slug (icon unavailable), shown outright. */}
                  <span
                    class="fallback"
                    hidden={!!chip.slug}
                    set:html={fallbacks[chip.fb ?? "generic"]}
                  />
                </span>
                <span class="chip-text">
                  <span class="chip-name">{chip.name}</span>
                  {chip.context && <span class="chip-ctx">{chip.context}</span>}
                </span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* --s is the single scale knob: 1 on desktop, 0.85 on mobile. Every chip
     dimension that should shrink references it via calc(), so the ~15% mobile
     reduction is one declaration rather than per-row overrides. */
  .stack-section {
    --s: 1;
    padding: 96px 0;
    border-top: 1px solid var(--color-border);
  }

  .inner {
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: 48px;
  }

  /* Section header — matches the Services / Experience convention. */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 12px;
  }

  .heading {
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-text-primary);
    /* +24px breathing room between heading and the pyramid. */
    margin-bottom: 72px;
  }

  .heading span {
    color: var(--color-accent);
    filter: brightness(1.3);
  }

  /* ---- Pyramid ---- */
  .pyramid {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pyr-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    width: 100%;
    gap: var(--row-gap);
    margin-bottom: var(--row-mb);
  }

  /* Per-row base sizing. Scalable values (icon / padding / fonts / inner gap)
     are read through calc(* var(--s)); radius, row gap and row margin are fixed. */
  .row-1 { --icon: 28px; --pad-y: 14px; --pad-x: 20px; --name-fs: 14px; --name-w: 600; --ctx-fs: 10px; --chip-gap: 11px; --radius: 12px; --row-gap: 16px; --row-mb: 40px; }
  .row-2 { --icon: 24px; --pad-y: 12px; --pad-x: 18px; --name-fs: 13px; --name-w: 500; --ctx-fs: 10px; --chip-gap: 10px; --radius: 11px; --row-gap: 14px; --row-mb: 32px; }
  .row-3 { --icon: 22px; --pad-y: 10px; --pad-x: 16px; --name-fs: 12px; --name-w: 500; --ctx-fs: 9px;  --chip-gap: 9px;  --radius: 10px; --row-gap: 12px; --row-mb: 28px; }
  .row-4 { --icon: 18px; --pad-y: 8px;  --pad-x: 14px; --name-fs: 11px; --name-w: 500; --chip-gap: 8px;  --radius: 9px;  --row-gap: 10px; --row-mb: 22px; }
  .row-5 { --icon: 16px; --pad-y: 6px;  --pad-x: 12px; --name-fs: 11px; --name-w: 400; --chip-gap: 7px;  --radius: 7px;  --row-gap: 8px;  --row-mb: 16px; }
  .row-6 { --icon: 14px; --pad-y: 5px;  --pad-x: 10px; --name-fs: 10px; --name-w: 400; --chip-gap: 6px;  --radius: 6px;  --row-gap: 6px;  --row-mb: 0; }

  /* ---- Chip — liquid glass, matching Services.astro cards ---- */
  .chip {
    /* Dark (default) premium white glass. */
    --g-bg: rgba(255, 255, 255, 0.03);
    --g-bg-hover: rgba(255, 255, 255, 0.05);
    --g-border: rgba(255, 255, 255, 0.08);
    --g-inner: rgba(255, 255, 255, 0.05);

    position: relative;
    display: inline-flex;
    align-items: center;
    gap: calc(var(--chip-gap) * var(--s));
    padding: calc(var(--pad-y) * var(--s)) calc(var(--pad-x) * var(--s));
    border-radius: var(--radius);
    border: 1px solid var(--g-border);
    background: var(--g-bg);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    transition: all 0.25s ease;
  }

  /* Light-theme fallback — swap white translucency for dark. */
  :global(html:not(.dark)) .chip {
    --g-bg: rgba(15, 15, 15, 0.04);
    --g-bg-hover: rgba(15, 15, 15, 0.06);
    --g-border: rgba(15, 15, 15, 0.1);
    --g-inner: rgba(15, 15, 15, 0.04);
  }

  /* Luminous inner border. */
  .chip::before {
    content: "";
    position: absolute;
    inset: 1px;
    border-radius: calc(var(--radius) - 1px);
    border: 1px solid var(--g-inner);
    pointer-events: none;
  }

  /* Top-edge light refraction line. */
  .chip::after {
    content: "";
    position: absolute;
    top: 0;
    left: 10%;
    width: 80%;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.25) 40%,
      color-mix(in srgb, var(--color-accent) 40%, transparent) 50%,
      rgba(255, 255, 255, 0.25) 60%,
      transparent
    );
  }

  /* Keep the icon + text above the pseudo-element layers. */
  .icon,
  .chip-text {
    position: relative;
    z-index: 1;
  }

  /* ---- Icon (img with inline-SVG fallback) ----
     A fixed, relatively-positioned box; the image is absolutely sized to fill
     it. Simple Icons SVGs carry only a viewBox (no intrinsic width/height), so
     an <img> with width:100% can blow past the wrapper — absolute inset:0 with
     an explicit box pins it to the row size in every browser. */
  .icon {
    flex-shrink: 0;
    display: block;
    width: calc(var(--icon) * var(--s));
    height: calc(var(--icon) * var(--s));
  }

  .chip-img,
  .fallback {
    position: absolute;
    inset: 0;
    width: calc(var(--icon) * var(--s));
    height: calc(var(--icon) * var(--s));
    flex-shrink: 0;
    display: block;
    object-fit: contain;
    /* Desaturated by default; full color on chip hover. */
    filter: grayscale(1) brightness(1.3);
    transition: filter 0.3s ease;
  }

  /* Hand-drawn fallbacks are teal so they grayscale → accent on hover,
     mirroring brand icons going gray → original color. */
  .fallback {
    color: var(--color-accent);
  }

  .fallback :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ---- Text block ---- */
  .chip-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    line-height: 1.2;
  }

  .chip-name {
    font-size: calc(var(--name-fs) * var(--s));
    font-weight: var(--name-w);
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .chip-ctx {
    font-size: calc(var(--ctx-fs) * var(--s));
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* ---- Hover: full-color icon applies to ALL rows (incl. row 6) ----
     Brand SVGs go gray → their own colors; fallbacks go gray → accent. */
  .chip:hover .chip-img,
  .chip:hover .fallback {
    filter: grayscale(0) brightness(1);
  }

  /* Lift / glass-brighten only on rows 1–5; row 6 stays understated. */
  .pyr-row:not(.row-6) .chip:hover {
    background: var(--g-bg-hover);
    border-color: rgba(29, 158, 117, 0.3);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(29, 158, 117, 0.12);
  }

  /* ---- Mobile: shrink every scaled dimension ~15% in one line ---- */
  @media (max-width: 768px) {
    .stack-section {
      --s: 0.85;
      padding: 64px 0;
    }
    .inner {
      padding-inline: 24px;
    }
  }
</style>
